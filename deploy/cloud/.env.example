# Copier en .env (jamais versionné) puis : chmod 600 .env

# MongoDB Atlas — la même URI que sur le Mac (~/.jarvis/launcher.json).
# L'adresse IP publique du serveur doit être autorisée dans Atlas
# (Network Access).
MONGO_URI=

# Clé d'authentification Tailscale (admin Tailscale > Settings > Keys),
# réutilisable de préférence : elle ne sert qu'au premier démarrage.
TS_AUTHKEY=

# Adresse Tailscale du Mac qui sert les modèles (100.x.y.z) :
#   tailscale ip -4      (sur le Mac)
MAC_TAILNET_IP=

# Nom de la machine dans le réseau privé : https://<nom>.<tailnet>.ts.net
TS_HOSTNAME=jarvis

# Fuseau des heures affichées.
TZ=Europe/Luxembourg

# Modèles servis par le Mac — à changer seulement s'ils changent là-bas.
#VLM_PORT=8080
#VLM_MODEL=olmOCR-2-7B-1025
#VLM_MODEL_VERSION=Q6_K
#LLM_PORT=8081
#LLM_MODEL=qwen3-8b
#LLM_MODEL_VERSION=Q5_K_M
