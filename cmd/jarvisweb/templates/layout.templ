package templates

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="fr">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<script src="/static/htmx.min.js"></script>
			<style>
				:root { color-scheme: light dark; }
				body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; max-width: 860px; margin: 2rem auto; padding: 0 1rem; line-height: 1.5; }
				h1 { font-size: 1.4rem; }
				h3 { font-size: 1.05rem; margin-bottom: .3rem; }
				.card { border: 1px solid #8884; border-radius: 8px; padding: 1rem 1.25rem; margin: 1rem 0; }
				label { display: block; margin-bottom: .35rem; font-weight: 600; }
				select, input[type=file] { display: block; margin-bottom: 1rem; }
				button { padding: .5rem 1rem; border-radius: 6px; border: 1px solid #8884; cursor: pointer; font-weight: 600; background: #8881; }
				button:hover { background: #8883; }
				.status-pending, .status-running { color: #a66; }
				.status-done { color: #2a2; }
				.status-failed { color: #c33; }
				table { border-collapse: collapse; width: 100%; margin: .5rem 0 1rem; }
				td, th { border: 1px solid #8884; padding: .4rem .6rem; text-align: left; font-size: .92rem; }
				tr.needs-review { background: #fffbe0; }
				.confidence { font-variant-numeric: tabular-nums; }
				.spinner { display: inline-block; width: 1em; height: 1em; border: 2px solid #8886; border-top-color: #555; border-radius: 50%; animation: spin 0.8s linear infinite; vertical-align: -0.15em; margin-right: .4em; }
				@keyframes spin { to { transform: rotate(360deg); } }
				.error-box { background: #fee2; border: 1px solid #c33; border-radius: 6px; padding: .75rem 1rem; color: #a33; }
				.muted { color: #888; font-size: .9rem; }
			</style>
		</head>
		<body>
			<h1>Jarvis — extraction de documents</h1>
			{ children... }
		</body>
	</html>
}
