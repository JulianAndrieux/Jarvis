package templates

import "strings"

templ Upload(docTypes []string) {
	@Layout("Jarvis — upload", "upload") {
		<div class="page-narrow">
			<div class="card">
				<form hx-post="/jobs" hx-target="#result" hx-swap="innerHTML" hx-encoding="multipart/form-data">
					<label for="file">Document (PDF)</label>
					<input type="file" name="file" id="file" accept="application/pdf" required/>
					<button type="submit">Traiter</button>
				</form>
				<p class="muted">
					Le type de document est déterminé automatiquement (classification).
					if len(docTypes) > 0 {
						Types reconnus aujourd'hui : { strings.Join(docTypes, ", ") }.
					}
				</p>
			</div>
			<div id="result"></div>
		</div>
	}
}
