package templates

templ Layout(title string, active string) {
	<!DOCTYPE html>
	<html lang="fr" class={ themeClass(active) }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<script src="/static/htmx.min.js"></script>
			<style>
				/* Jalon 22 : refonte visuelle. Toutes les couleurs passent par
				   les variables ci-dessous, redéfinies en bloc pour le thème
				   sombre — jamais de fond codé en dur avec un texte hérité du
				   système (le bug "blanc sur blanc" de l'ex-cmd/codebrowser).
				   Polices système uniquement : l'application tourne en local,
				   rien n'est chargé depuis Internet. */
				:root {
					color-scheme: light;
					--bg: #f5f6f8;
					--surface: #ffffff;
					--surface-2: #f0f1f4;
					--border: #e3e5ea;
					--text: #14161a;
					--text-2: #4b5160;
					--muted: #7a8090;
					--accent: #4f5bd5;
					--accent-soft: #eceefe;
					--ok: #1f8a4c;
					--ok-soft: #e5f5ec;
					--warn: #a86400;
					--warn-soft: #fff4e0;
					--danger: #c23b3b;
					--danger-soft: #fdecec;
					--code-bg: #1d2029;
					--code-text: #e4e6ee;
					--shadow: 0 1px 2px rgba(16, 20, 30, .05), 0 2px 8px rgba(16, 20, 30, .04);
					--shadow-hover: 0 4px 16px rgba(16, 20, 30, .10);
					--radius: 10px;
					--header-h: 56px;
				}
				/* Jalon 33 : deux espaces. L'application (Importer, Documents,
				   Notes, Tâches, Tickets) est toujours claire ; l'Admin (/admin)
				   toujours sombre — quel que soit le réglage du système. */
				html.theme-admin {
					color-scheme: dark;
					--bg: #121419;
					--surface: #1a1d24;
					--surface-2: #22262f;
					--border: #2d323d;
					--text: #eceef3;
					--text-2: #b4b9c6;
					--muted: #8a90a0;
					--accent: #8b95ff;
					--accent-soft: #262b4a;
					--ok: #4cc27f;
					--ok-soft: #173325;
					--warn: #f0b04a;
					--warn-soft: #3a2c12;
					--danger: #f07272;
					--danger-soft: #3b1c1c;
					--code-bg: #0e1015;
					--shadow: 0 1px 2px rgba(0, 0, 0, .3);
					--shadow-hover: 0 4px 16px rgba(0, 0, 0, .45);
				}
				/* Application : plus aérée et plus douce. */
				html.theme-user {
					--bg: #f7f8fb;
					--border: #e6e8ef;
					--accent: #4a5bdc;
					--accent-soft: #eef0ff;
					--radius: 14px;
					--header-h: 64px;
					--shadow: 0 1px 3px rgba(20, 30, 60, .06), 0 4px 14px rgba(20, 30, 60, .05);
				}
				html.theme-user body { font-size: 15.5px; }
				html.theme-user .app-nav a { padding: .5rem .95rem; border-radius: 999px; font-size: .95rem; }
				html.theme-user .app-nav .nav-icon { margin-right: .35rem; }
				html.theme-user button, html.theme-user .button { border-radius: 10px; padding: .55rem 1rem; }
				html.theme-user .task-check { padding: 0 .2rem; }
				.space-link { margin-left: auto; font-size: .85rem; color: var(--muted); padding: .35rem .7rem; border-radius: 8px; border: 1px solid var(--border); }
				.space-link:hover { color: var(--text); text-decoration: none; background: var(--surface-2); }
				.admin-badge { font-size: .68rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--warn); border: 1px solid color-mix(in srgb, var(--warn) 50%, transparent); border-radius: 6px; padding: .05rem .4rem; }
				.app-header .space-link + form, .app-header form + .space-link { margin-left: .6rem; }

				* { box-sizing: border-box; }
				body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif; margin: 0; background: var(--bg); color: var(--text); line-height: 1.5; -webkit-font-smoothing: antialiased; }
				a { color: var(--accent); text-decoration: none; }
				a:hover { text-decoration: underline; }

				/* En-tête */
				.app-header { position: sticky; top: 0; z-index: 10; height: var(--header-h); display: flex; align-items: center; gap: 2rem; padding: 0 1.5rem; background: color-mix(in srgb, var(--surface) 88%, transparent); backdrop-filter: saturate(1.4) blur(10px); border-bottom: 1px solid var(--border); }
				.brand { display: flex; align-items: center; gap: .55rem; font-weight: 700; font-size: 1.02rem; color: var(--text); letter-spacing: -.01em; }
				.brand:hover { text-decoration: none; }
				.brand-mark { width: 26px; height: 26px; border-radius: 7px; background: linear-gradient(135deg, var(--accent), #9a5bd5); display: grid; place-items: center; color: #fff; font-size: .8rem; font-weight: 800; }
				.app-nav { display: flex; gap: .25rem; }
				.app-nav a { padding: .38rem .8rem; border-radius: 8px; color: var(--text-2); font-weight: 550; font-size: .92rem; }
				.app-nav a:hover { background: var(--surface-2); color: var(--text); text-decoration: none; }
				.app-nav a.active { background: var(--accent-soft); color: var(--accent); }
				.app-header form { margin-left: auto; }

				/* Boutons et champs */
				button, .button { display: inline-flex; align-items: center; gap: .4rem; padding: .45rem .9rem; border-radius: 8px; border: 1px solid var(--border); cursor: pointer; font: inherit; font-weight: 600; font-size: .88rem; background: var(--surface); color: var(--text); box-shadow: var(--shadow); }
				button:hover, .button:hover { background: var(--surface-2); text-decoration: none; }
				.button-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
				.button-primary:hover { background: color-mix(in srgb, var(--accent) 88%, #000); }
				.button-ghost { background: transparent; box-shadow: none; }
				.button-danger { border-color: color-mix(in srgb, var(--danger) 40%, var(--border)); color: var(--danger); }
				.button-danger:hover { background: var(--danger-soft); }
				label { display: block; margin-bottom: .35rem; font-weight: 600; font-size: .85rem; color: var(--text-2); }
				input[type=text], input[type=password], select, textarea { font: inherit; font-size: .92rem; padding: .5rem .7rem; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--text); width: 100%; }
				textarea { resize: vertical; line-height: 1.45; }
				/* Relecture des diffs (jalon 36) */
				.review-block.review-ok { border-color: color-mix(in srgb, var(--ok) 40%, var(--border)); }
				.review-verdict { font-weight: 700; margin: 0 0 .4rem; }
				.review-issues { list-style: none; padding: 0; margin: .4rem 0 0; }
				.review-issues li { display: flex; gap: .5rem; align-items: baseline; flex-wrap: wrap; padding: .3rem 0; border-top: 1px solid var(--border); }
				.review-capture { margin-top: .8rem; }
				.review-capture-page { font-weight: 600; font-size: .85rem; margin-bottom: .3rem; }
				.review-capture-pair { display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; }
				.review-capture-pair figure { margin: 0; }
				.review-capture-pair figcaption { font-size: .78rem; color: var(--muted); margin-bottom: .2rem; }
				.review-capture-pair img { width: 100%; border: 1px solid var(--border); border-radius: 8px; }
				/* Barre latérale (jalon 34) */
				.with-sidebar { display: flex; align-items: flex-start; }
				.main-col { flex: 1; min-width: 0; }
				.sidebar { width: 300px; flex: none; position: sticky; top: var(--header-h); height: calc(100vh - var(--header-h)); overflow-y: auto; padding: 1.25rem 1rem; border-left: 1px solid var(--border); background: var(--surface); }
				html.sidebar-hidden .sidebar { display: none; }
				.sidebar-toggle, html.theme-user .sidebar-toggle { margin-left: auto; padding: .3rem .55rem; box-shadow: none; }
				.sidebar-toggle + .space-link { margin-left: .5rem; }
				.side-block { margin-bottom: 1.4rem; }
				.side-title { font-weight: 700; font-size: .88rem; margin-bottom: .5rem; display: flex; align-items: center; gap: .4rem; }
				.side-title .count { margin-left: auto; font-size: .72rem; font-weight: 700; background: var(--surface-2); color: var(--text-2); border-radius: 999px; padding: .05rem .5rem; }
				.side-title .count-alert { background: var(--danger-soft); color: var(--danger); }
				.side-list { list-style: none; margin: 0; padding: 0; }
				.side-list li { border-radius: 10px; }
				.side-task { display: flex; align-items: center; gap: .35rem; padding: .25rem .2rem; font-size: .88rem; }
				.side-task .task-check { font-size: 1rem; }
				.side-task-title { flex: 1; min-width: 0; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
				.side-prio { color: var(--danger); font-weight: 800; }
				.side-due { font-size: .72rem; font-weight: 600; color: var(--warn); background: var(--warn-soft); border-radius: 999px; padding: .05rem .45rem; white-space: nowrap; }
				.side-due.side-overdue { color: var(--danger); background: var(--danger-soft); }
				.side-item { display: flex; flex-direction: column; padding: .4rem .5rem; border-radius: 10px; color: var(--text); font-size: .86rem; }
				.side-item:hover { background: var(--surface-2); text-decoration: none; }
				.side-item-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 550; }
				.side-item-detail { font-size: .76rem; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
				.side-error .side-item-detail { color: var(--danger); }
				.side-empty { font-size: .82rem; color: var(--muted); margin: .2rem 0 .4rem; }
				.side-more { display: block; font-size: .8rem; margin-top: .35rem; }
				@media (max-width: 1000px) { .sidebar { display: none; } }
				/* Notes et tâches (jalon 32) */
				.note-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); gap: 1rem; }
				.note-card { display: block; margin: 0; color: var(--text); }
				.note-card:hover { text-decoration: none; box-shadow: var(--shadow-hover); }
				.note-card-title { font-weight: 700; margin-bottom: .35rem; }
				.note-excerpt { color: var(--text-2); font-size: .88rem; margin: 0 0 .5rem; }
				.note-page { max-width: 900px; }
				.note-editor label { margin-top: .8rem; }
				.note-editor textarea { font-size: .88rem; }
				.inline-check { display: flex; align-items: center; gap: .5rem; font-weight: 500; }
				.markdown h4 { margin: .8rem 0 .4rem; }
				.markdown ul, .markdown ol { padding-left: 1.3rem; }
				.quick-add { display: flex; gap: .6rem; }
				.quick-add input[type=text] { flex: 1; min-width: 0; }
				.quick-help { margin: .35rem 0 1rem; }
				.task-group { margin: 1rem 0; }
				.task-group-title { font-weight: 700; font-size: .9rem; color: var(--text-2); margin-bottom: .4rem; }
				.task-group-en_retard .task-group-title { color: var(--danger); }
				.task-list { list-style: none; margin: 0; padding: 0; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
				.task-row { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; padding: .45rem .75rem; border-top: 1px solid var(--border); }
				.task-row:first-child { border-top: none; }
				.task-done .task-title { text-decoration: line-through; color: var(--muted); }
				.task-check { background: none; border: none; box-shadow: none; font-size: 1.15rem; padding: 0 .2rem; cursor: pointer; color: var(--text); }
				.task-title { color: var(--text); flex: 1 1 12rem; }
				.task-fields { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: .8rem; }
				.inline-form { display: inline; margin: 0; }
				.link-list { list-style: none; padding: 0; margin: 0 0 .6rem; }
				.link-list li { display: flex; align-items: center; gap: .4rem; padding: .2rem 0; }
				/* Emails (jalon 39) */
				.mail-status { margin: -.6rem 0 1rem; }
				.mail-connect { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-top: 0; }
				.mail-connect p { margin: 0; }
				.mail-list { list-style: none; margin: 0; padding: 0; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
				.mail-list li + li { border-top: 1px solid var(--border); }
				.mail-row { display: grid; grid-template-columns: minmax(8rem, 13rem) 1fr auto; gap: .9rem; align-items: center; padding: .6rem .9rem; color: var(--text); }
				.mail-row:hover { background: var(--surface-2); text-decoration: none; }
				.mail-from, .mail-subject { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
				.mail-main { display: flex; flex-direction: column; min-width: 0; }
				.mail-summary { color: var(--text-2); font-size: .85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
				.mail-unread .mail-from, .mail-unread .mail-subject { font-weight: 700; }
				.mail-side { display: flex; align-items: center; gap: .5rem; justify-content: flex-end; }
				@media (max-width: 760px) { .mail-row { grid-template-columns: 1fr; gap: .2rem; } .mail-side { justify-content: flex-start; } }
				.chip-cat-a_traiter { background: var(--danger-soft); color: var(--danger); }
				.chip-cat-document { background: var(--accent-soft); color: var(--accent); }
				.chip-cat-information { background: var(--ok-soft); color: var(--ok); }
				.chip-cat-notification { background: var(--surface-2); color: var(--text-2); }
				.chip-cat-newsletter { background: var(--warn-soft); color: var(--warn); }
				.mail-headers { margin: 0 0 1rem; }
				.mail-body { white-space: pre-wrap; overflow-wrap: anywhere; font-family: inherit; font-size: .92rem; line-height: 1.5; }
				/* Onglet Agents */
				.agent-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr)); gap: 1rem; }
				.agent-card { display: block; margin: 0; color: var(--text); }
				.agent-card:hover { text-decoration: none; box-shadow: var(--shadow-hover); }
				.agent-card-head { display: flex; justify-content: space-between; align-items: center; gap: .5rem; flex-wrap: wrap; }
				.agent-name { font-weight: 700; }
				.agent-role { color: var(--text-2); margin: .5rem 0 .75rem; max-width: 70ch; }
				.agent-facts { display: grid; grid-template-columns: auto 1fr; gap: .25rem .75rem; margin: 0; font-size: .85rem; }
				.agent-facts dt { color: var(--muted); }
				.agent-facts dd { margin: 0; overflow-wrap: anywhere; }
				.agent-editor textarea { font-size: .85rem; }
				.agent-actions { margin-top: .6rem; }
				.placeholder-list { margin: .25rem 0 .75rem; padding-left: 1.2rem; }
				.form-error { color: var(--danger); background: var(--danger-soft); padding: .5rem .75rem; border-radius: 8px; }
				.comment-actions { margin-top: .5rem; }
				input[type=text]:focus, input[type=password]:focus, select:focus, textarea:focus { outline: 2px solid var(--accent); outline-offset: -1px; border-color: transparent; }
				.field-row { display: flex; gap: .5rem; align-items: center; }
				.field-row > input, .field-row > select { flex: 1; }

				/* Mises en page */
				.page-narrow { max-width: 760px; margin: 2.5rem auto; padding: 0 1rem; }
				.page-wide { max-width: 1280px; margin: 2rem auto; padding: 0 1.5rem; }
				.page-title { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
				.page-title h2 { margin: 0; font-size: 1.5rem; letter-spacing: -.02em; }
				.card { border: 1px solid var(--border); border-radius: var(--radius); padding: 1.1rem 1.25rem; margin: 1rem 0; background: var(--surface); box-shadow: var(--shadow); }

				/* Pastilles, badges */
				.chip { display: inline-flex; align-items: center; gap: .35rem; font-size: .75rem; font-weight: 600; padding: .15rem .55rem; border-radius: 999px; background: var(--surface-2); color: var(--text-2); white-space: nowrap; }
				.chip-type { background: var(--accent-soft); color: var(--accent); }
				.chip-done { background: var(--ok-soft); color: var(--ok); }
				.chip-pending, .chip-running { background: var(--warn-soft); color: var(--warn); }
				.chip-failed { background: var(--danger-soft); color: var(--danger); }
				.chip-review { background: var(--warn-soft); color: var(--warn); }
				.dot { width: .5rem; height: .5rem; border-radius: 50%; background: currentColor; }

				/* Statuts (conservés : utilisés aussi par les tests serveur) */
				.status-pending, .status-running { color: var(--warn); }
				.status-done { color: var(--ok); }
				.status-failed { color: var(--danger); }
				.error-box { background: var(--danger-soft); border: 1px solid color-mix(in srgb, var(--danger) 35%, transparent); border-radius: 8px; padding: .7rem .9rem; color: var(--danger); font-size: .9rem; white-space: pre-wrap; }
				.warn-box { background: var(--warn-soft); border-radius: 8px; padding: .7rem .9rem; color: var(--warn); font-size: .9rem; }
				.push-commits { margin: .2rem 0 .8rem; padding-left: 1.2rem; font-size: .86rem; }
				.ok-box { background: var(--ok-soft); border-radius: 8px; padding: .7rem .9rem; color: var(--ok); font-size: .9rem; }
				.spinner { display: inline-block; width: 1em; height: 1em; border: 2px solid color-mix(in srgb, currentColor 30%, transparent); border-top-color: currentColor; border-radius: 50%; animation: spin .8s linear infinite; vertical-align: -.15em; }
				@keyframes spin { to { transform: rotate(360deg); } }

				/* Upload : zone de dépôt. L'input fichier recouvre toute la
				   zone (transparent) : le glisser-déposer marche nativement,
				   sans JavaScript. */
				.dropzone { position: relative; display: grid; place-items: center; text-align: center; gap: .3rem; padding: 2.75rem 1rem; border: 2px dashed var(--border); border-radius: 14px; background: var(--surface); transition: border-color .15s, background .15s; }
				.dropzone:hover, .dropzone:focus-within { border-color: var(--accent); background: var(--accent-soft); }
				.dropzone input[type=file] { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; }
				.dropzone-icon { font-size: 2rem; line-height: 1; }
				.dropzone-title { font-weight: 650; }
				.upload-actions { display: flex; justify-content: flex-end; margin-top: 1rem; }

				/* Bibliothèque : recherche + grille de cartes */
				.search-bar { display: flex; gap: .6rem; margin: 0 0 1.5rem; }
				.search-bar input[type=text] { font-size: 1.02rem; padding: .7rem 1rem; border-radius: 10px; }
				.search-bar { flex-wrap: wrap; align-items: center; }
				.search-bar input[type=text] { flex: 1 1 18rem; }
				.date-field { display: flex; align-items: center; gap: .4rem; margin: 0; font-weight: 500; color: var(--text-2); white-space: nowrap; }
				.date-field input[type=date] { font: inherit; padding: .6rem .7rem; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); color: var(--text); }
				.doc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 1.1rem; }
				.doc-card { position: relative; display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 12px; background: var(--surface); box-shadow: var(--shadow); overflow: hidden; color: inherit; transition: box-shadow .15s, transform .15s; }
				.doc-card:hover { box-shadow: var(--shadow-hover); transform: translateY(-2px); text-decoration: none; }
				.doc-thumb { aspect-ratio: 3 / 4; background: var(--surface-2); display: grid; place-items: center; border-bottom: 1px solid var(--border); overflow: hidden; }
				.doc-thumb img { width: 100%; height: 100%; object-fit: contain; background: #fff; }
				.doc-card-body { padding: .7rem .8rem .8rem; display: flex; flex-direction: column; gap: .4rem; }
				.doc-name { font-weight: 600; font-size: .9rem; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; word-break: break-word; }
				.doc-meta { display: flex; flex-wrap: wrap; gap: .3rem; align-items: center; }
				.doc-date { font-size: .75rem; color: var(--muted); }
				.doc-card .card-delete { position: absolute; top: .5rem; right: .5rem; padding: .25rem .45rem; font-size: .8rem; opacity: 0; transition: opacity .15s; }
				.doc-card:hover .card-delete, .doc-card .card-delete:focus { opacity: 1; }
				.empty-state { text-align: center; padding: 4rem 1rem; color: var(--muted); }
				/* Jalon 25 : tous types de fichiers */
				.type-filters { display: flex; flex-wrap: wrap; gap: .4rem; margin: -.6rem 0 1.25rem; }
				.filter-chip { font-size: .8rem; padding: .25rem .7rem; color: var(--text-2); }
				.filter-chip:hover { background: var(--border); text-decoration: none; }
				.filter-chip.active { background: var(--accent); color: #fff; }
				.doc-thumb { position: relative; }
				.doc-icon { font-size: 3.2rem; line-height: 1; }
				.ext-badge { position: absolute; left: .5rem; bottom: .5rem; font: 700 .65rem/1 ui-monospace, Menlo, monospace; letter-spacing: .03em; padding: .25rem .4rem; border-radius: 4px; background: color-mix(in srgb, var(--text) 78%, transparent); color: var(--bg); }
				.panel-actions { margin-top: .75rem; display: flex; gap: .5rem; }
				.preview-stack { position: relative; height: 100%; }
				.preview-stack iframe { width: 100%; height: 100%; border: 0; display: block; background: #fff; }
				.preview-alt { position: absolute; top: .6rem; right: .9rem; font-size: .78rem; padding: .2rem .55rem; border-radius: 6px; background: var(--surface); border: 1px solid var(--border); }
				.preview-image-wrap { height: 100%; display: grid; place-items: center; overflow: auto; padding: 1rem; }
				.preview-image { max-width: 100%; max-height: 100%; object-fit: contain; box-shadow: var(--shadow-hover); border-radius: 4px; background: #fff; }
				.preview-placeholder { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .4rem; text-align: center; padding: 2rem; color: var(--text-2); }

				/* Détail : aperçu à gauche, informations à droite */
				.doc-shell { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(400px, 1fr); height: calc(100vh - var(--header-h)); }
				.doc-preview { background: var(--surface-2); border-right: 1px solid var(--border); min-height: 0; }
				.doc-preview iframe { width: 100%; height: 100%; border: 0; display: block; }
				.doc-panel { overflow-y: auto; min-height: 0; padding: 1.25rem 1.75rem 3rem; }
				.panel-back { font-size: .85rem; color: var(--muted); }
				.panel-title { font-size: 1.35rem; margin: .4rem 0 .5rem; letter-spacing: -.015em; word-break: break-word; }
				.panel-badges { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: .5rem; }
				.panel-meta { font-size: .82rem; color: var(--muted); display: flex; flex-wrap: wrap; gap: .25rem .9rem; }
				.tabs { display: flex; gap: .2rem; border-bottom: 1px solid var(--border); margin: 1.25rem 0 1rem; position: sticky; top: -1.25rem; background: var(--bg); z-index: 1; padding-top: .5rem; }
				.tab { border: 0; box-shadow: none; background: transparent; border-radius: 0; padding: .55rem .8rem; color: var(--muted); border-bottom: 2px solid transparent; margin-bottom: -1px; }
				.tab:hover { background: transparent; color: var(--text); }
				.tab[aria-selected=true] { color: var(--accent); border-bottom-color: var(--accent); }
				.tab .count { font-size: .72rem; background: var(--surface-2); color: var(--muted); border-radius: 999px; padding: 0 .4rem; margin-left: .15rem; }
				.tab-panel[hidden] { display: none; }

				/* Champs extraits */
				.field-list { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); overflow: hidden; }
				.field { display: grid; grid-template-columns: minmax(120px, 34%) 1fr; gap: .2rem 1rem; padding: .7rem 1rem; border-bottom: 1px solid var(--border); }
				.field:last-child { border-bottom: 0; }
				.field.low { background: var(--warn-soft); }
				.field-name { font-size: .8rem; color: var(--text-2); font-weight: 600; padding-top: .1rem; word-break: break-word; }
				.field-value { font-size: .95rem; font-weight: 550; word-break: break-word; }
				.field-extra { grid-column: 2; display: flex; align-items: center; gap: .6rem; font-size: .75rem; color: var(--muted); }
				.conf { display: inline-flex; align-items: center; gap: .35rem; font-variant-numeric: tabular-nums; }
				.conf-bar { width: 44px; height: 4px; border-radius: 2px; background: var(--surface-2); overflow: hidden; }
				.conf-bar > span { display: block; height: 100%; background: var(--ok); }
				.field.low .conf-bar > span { background: var(--warn); }
				.snippet { font-style: italic; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

				/* Texte OCR et analyse LLM, par page */
				.page-block { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); margin-bottom: 1rem; overflow: hidden; }
				.page-block-head { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; padding: .55rem .9rem; background: var(--surface-2); border-bottom: 1px solid var(--border); font-size: .82rem; }
				.page-block-head strong { font-size: .88rem; }
				.page-block-head .model { color: var(--muted); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .75rem; }
				.page-block-body { padding: .9rem; }
				.ocr-text { margin: 0; padding: .9rem; white-space: pre-wrap; word-break: break-word; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .78rem; line-height: 1.55; max-height: 460px; overflow: auto; color: var(--text-2); }
				details.raw { margin-top: .6rem; }
				details.raw summary { cursor: pointer; font-size: .8rem; color: var(--muted); font-weight: 600; }
				details.raw pre { background: var(--code-bg); color: var(--code-text); padding: .7rem .85rem; border-radius: 8px; overflow: auto; font-size: .75rem; max-height: 360px; white-space: pre-wrap; word-break: break-word; }

				/* Avancement (jalon 23) */
				.progress { margin: .75rem 0; }
				.progress-label { display: flex; justify-content: space-between; font-size: .85rem; margin-bottom: .35rem; color: var(--text-2); }
				.progress-bar { height: 6px; border-radius: 3px; background: var(--surface-2); overflow: hidden; }
				.progress-bar > span { display: block; height: 100%; background: var(--accent); transition: width .4s; }

				/* Onglet Infos */
				.info-grid { display: grid; grid-template-columns: max-content 1fr; gap: .45rem 1.25rem; font-size: .88rem; margin: 0; }
				.info-grid dt { color: var(--muted); }
				.info-grid dd { margin: 0; word-break: break-word; }
				.section-title { font-size: .78rem; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); margin: 1.5rem 0 .6rem; font-weight: 700; }
				.danger-zone { border-color: color-mix(in srgb, var(--danger) 30%, var(--border)); }

				@media (max-width: 900px) {
					.doc-shell { grid-template-columns: 1fr; height: auto; }
					.doc-preview { height: 70vh; border-right: 0; border-bottom: 1px solid var(--border); }
					.doc-panel { overflow: visible; padding: 1rem; }
					.app-header { gap: 1rem; padding: 0 1rem; }
				}

				/* Pages pleine hauteur, deux volets (Classes, Tests) : ex-cmd/codebrowser. */
				main.two-pane { display: flex; height: calc(100vh - var(--header-h)); }
				.sidebar { width: 320px; overflow-y: auto; border-right: 1px solid var(--border); background: var(--surface); padding: .75rem; }
				.detail { flex: 1; overflow-y: auto; padding: 1.25rem 1.5rem; }
				.pkg-group { margin-bottom: .6rem; }
				.pkg-group summary { cursor: pointer; font-weight: 600; font-size: .85rem; color: var(--muted); padding: .2rem 0; }
				.type-link { display: block; padding: .2rem .4rem .2rem 1rem; border-radius: 6px; color: inherit; font-size: .9rem; }
				.type-link:hover { background: var(--surface-2); text-decoration: none; }
				.type-link.kind-interface { font-style: italic; }
				.badge { display: inline-block; font-size: .7rem; padding: .05rem .45rem; border-radius: 4px; margin-left: .3rem; vertical-align: middle; font-weight: 600; }
				.badge-struct { background: var(--accent-soft); color: var(--accent); }
				.badge-interface { background: var(--warn-soft); color: var(--warn); }
				.rel-list a { display: inline-block; margin: .15rem .5rem .15rem 0; padding: .1rem .5rem; border-radius: 6px; background: var(--surface-2); color: inherit; font-size: .85rem; }
				.rel-list a:hover { background: var(--border); text-decoration: none; }
				.cat-card { border: 1px solid var(--border); border-radius: var(--radius); padding: .85rem 1.1rem; margin-bottom: 1rem; background: var(--surface); box-shadow: var(--shadow); }
				.cat-card h3 { display: flex; align-items: center; gap: .6rem; font-size: 1rem; color: inherit; margin-top: 0; }
				.test-row { display: flex; align-items: center; gap: .5rem; padding: .25rem 0; border-bottom: 1px solid var(--border); font-size: .88rem; }
				.test-row:last-child { border-bottom: none; }
				.test-name { flex: 1; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
				.status-dot { display: inline-block; width: .7em; height: .7em; border-radius: 50%; background: var(--muted); flex-shrink: 0; }
				.status-pass .status-dot { background: var(--ok); }
				.status-fail .status-dot { background: var(--danger); }
				.status-skip .status-dot { background: var(--warn); }
				.status-fail .test-name { color: var(--danger); }
				.tag { font-size: .7rem; padding: .05rem .4rem; border-radius: 4px; background: var(--surface-2); }
				.tag-integration { background: var(--warn-soft); color: var(--warn); }
				pre.output { background: var(--code-bg); color: var(--code-text); padding: .6rem .8rem; border-radius: 8px; overflow-x: auto; font-size: .8rem; margin: .3rem 0; }
				.summary-line { font-size: .85rem; margin: .4rem 0 .7rem; }

				/* Code (jalon 24) : couleurs du thème par défaut de VS Code
				   (Dark+), quel que soit le thème de l'application — c'est le
				   rendu reconnaissable demandé. */
				.code-block { margin: .5rem 0 1.25rem; border-radius: 8px; overflow: hidden; border: 1px solid #2b2b2b; }
				.code-file { background: #252526; color: #9d9d9d; font: 12px Menlo, Monaco, "SF Mono", Consolas, monospace; padding: .35rem .8rem; border-bottom: 1px solid #1a1a1a; }
				pre.code { margin: 0; background: #1e1e1e; color: #d4d4d4; font: 12.5px/1.55 Menlo, Monaco, "SF Mono", Consolas, "Courier New", monospace; padding: .6rem 0; overflow-x: auto; tab-size: 4; }
				pre.code code { font: inherit; }
				.code-line { display: inline-block; min-width: 100%; padding-right: 1rem; }
				.code-line:hover { background: #2a2d2e; }
				.code-line::before { content: attr(data-ln); display: inline-block; width: 3.2em; padding-right: 1.2em; text-align: right; color: #6e7681; user-select: none; }
				.tok-kw { color: #569cd6; }
				.tok-ctl { color: #c586c0; }
				.tok-type { color: #4ec9b0; }
				.tok-fn { color: #dcdcaa; }
				.tok-var { color: #9cdcfe; }
				.tok-str { color: #ce9178; }
				.tok-num { color: #b5cea8; }
				.tok-com { color: #6a9955; }

				/* Classes : barre latérale, fiche UML, relations */
				.sidebar-filter { margin-bottom: .6rem; }
				.kind-dot { display: inline-block; width: .5rem; height: .5rem; border-radius: 2px; margin-right: .45rem; background: var(--accent); vertical-align: .05em; }
				.kind-dot.kind-interface { background: var(--warn); border-radius: 50%; }
				.kind-dot.kind-other { background: var(--muted); }
				.type-page { max-width: 1100px; }
				.type-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 1.25rem; }
				.type-head h2 { margin: 0; font-size: 1.5rem; letter-spacing: -.01em; }
				.type-overview { display: grid; grid-template-columns: minmax(320px, 520px) 1fr; gap: 1.5rem; align-items: start; margin-bottom: 1rem; }
				.uml { border: 1.5px solid var(--accent); border-radius: 10px; background: var(--surface); box-shadow: var(--shadow); overflow: hidden; font-size: .86rem; }
				.uml-interface { border-color: var(--warn); }
				.uml-head { text-align: center; padding: .6rem .8rem .55rem; background: var(--accent-soft); border-bottom: 1.5px solid var(--accent); }
				.uml-interface .uml-head { background: var(--warn-soft); border-bottom-color: var(--warn); }
				.uml-stereo { font-size: .72rem; color: var(--muted); font-style: italic; }
				.uml-name { font-weight: 700; font-size: 1.05rem; }
				.uml-interface .uml-name { font-style: italic; }
				.uml-pkg { font-size: .72rem; color: var(--muted); font-family: ui-monospace, Menlo, monospace; }
				.uml-section { padding: .4rem 0; border-bottom: 1px solid var(--border); }
				.uml-section:last-child { border-bottom: 0; }
				.uml-row { display: grid; grid-template-columns: 1.1rem auto 1fr; gap: .5rem; padding: .12rem .8rem; font-family: ui-monospace, Menlo, monospace; font-size: .8rem; align-items: baseline; }
				.uml-row:hover { background: var(--surface-2); }
				.uml-vis { color: var(--muted); }
				.uml-member { font-weight: 600; }
				.uml-method { color: var(--text); }
				.uml-embed .uml-member { font-style: italic; color: var(--muted); }
				.uml-type { color: var(--text-2); word-break: break-all; }
				.uml-type a { color: var(--accent); }
				.uml-ref { margin-left: .4rem; font-size: .75rem; }
				.uml-empty { padding: .1rem .8rem; color: var(--muted); font-size: .78rem; font-style: italic; }
				.relations { display: flex; flex-direction: column; gap: .9rem; }
				.rel-title { font-size: .78rem; font-weight: 700; color: var(--text-2); margin-bottom: .3rem; }
				.rel-arrow { color: var(--accent); }

				/* Modèle de données (jalon 24) */
				.model-page { display: flex; flex-direction: column; height: calc(100vh - var(--header-h)); }
				.model-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.25rem; padding: .6rem 1.25rem; border-bottom: 1px solid var(--border); background: var(--surface); }
				.model-toolbar label.inline { display: flex; align-items: center; gap: .45rem; margin: 0; font-size: .82rem; }
				.model-toolbar select { width: auto; padding: .3rem .5rem; font-size: .85rem; }
				.model-toolbar .checkbox input { margin: 0; }
				.zoom-controls { display: flex; gap: .25rem; }
				.zoom-controls button { padding: .25rem .6rem; }
				.legend { display: flex; gap: 1rem; font-size: .75rem; color: var(--muted); margin-left: auto; }
				.legend span { display: inline-flex; align-items: center; gap: .3rem; }
				.model-body { flex: 1; display: grid; grid-template-columns: 1fr 380px; min-height: 0; }
				.diagram-viewport { position: relative; overflow: hidden; background-color: var(--bg); background-image: radial-gradient(color-mix(in srgb, var(--muted) 25%, transparent) 1px, transparent 1px); background-size: 20px 20px; cursor: grab; }
				.diagram-viewport:active { cursor: grabbing; }
				.diagram-viewport svg { width: 100%; height: 100%; display: block; user-select: none; }
				.model-side { overflow-y: auto; padding: 1rem; border-left: 1px solid var(--border); background: var(--surface); display: flex; flex-direction: column; gap: .9rem; }
				.dbox { fill: var(--surface); stroke: var(--border); stroke-width: 1.2; }
				.dhead { fill: var(--surface-2); }
				.dnode:hover .dbox { stroke: var(--accent); }
				.dnode.focus .dbox { stroke: var(--accent); stroke-width: 2.5; }
				.dnode.focus .dhead { fill: var(--accent-soft); }
				.dnode.iface .dbox { stroke-dasharray: 5 3; }
				.dnode.iface .dhead { fill: var(--warn-soft); }
				.dname { font: 700 13px -apple-system, BlinkMacSystemFont, sans-serif; fill: var(--text); }
				.dnode.iface .dname { font-style: italic; }
				.dpkg { font: 10.5px ui-monospace, Menlo, monospace; fill: var(--muted); }
				.drow { font: 12px ui-monospace, Menlo, monospace; }
				.dfield { fill: var(--text); }
				.dtype { fill: var(--muted); }
				.dmore { font: italic 11px -apple-system, sans-serif; fill: var(--muted); }
				.dedge { fill: none; stroke: color-mix(in srgb, var(--muted) 80%, transparent); stroke-width: 1.4; }
				.dedge-embed { stroke: var(--accent); }
				.dedge-implements { stroke: var(--warn); stroke-dasharray: 6 4; }
				g:hover > .dedge { stroke: var(--accent); stroke-width: 2.2; }
				.marker-fill { fill: var(--muted); }
				.marker-hollow { fill: var(--surface); stroke: var(--muted); stroke-width: 1.3; }
				.dcard { font: 600 11px ui-monospace, Menlo, monospace; fill: var(--accent); }

				/* Tests : ligne dépliable avec le code (jalon 24) */
				.test-item { position: relative; border-bottom: 1px solid var(--border); }
				.test-item:last-child { border-bottom: none; }
				.test-item > details > summary { list-style: none; cursor: pointer; padding-right: 3rem; border-bottom: none; }
				.test-item > details > summary::-webkit-details-marker { display: none; }
				.test-item > details > summary::before { content: "▸"; color: var(--muted); width: .8rem; }
				.test-item > details[open] > summary::before { content: "▾"; }
				.test-item > details > .code-block { margin: .3rem 0 .8rem 1.2rem; }
				.test-run { position: absolute; top: .15rem; right: 0; padding: .15rem .55rem; font-size: .8rem; }

				@media (max-width: 1000px) {
					.type-overview, .model-body { grid-template-columns: 1fr; }
					.model-side { border-left: 0; border-top: 1px solid var(--border); }
				}

				/* Tickets (jalons 26-27) */
				textarea { font: inherit; font-size: .92rem; padding: .5rem .7rem; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--text); width: 100%; resize: vertical; }
				.tickets-layout { display: grid; grid-template-columns: minmax(300px, 420px) 1fr; gap: 1.5rem; align-items: start; }
				.ticket-form { display: flex; flex-direction: column; gap: .35rem; margin: 0; }
				.ticket-form button { margin-top: .6rem; align-self: flex-start; }
				.ticket-list { display: flex; flex-direction: column; gap: .5rem; }
				.ticket-row { display: grid; grid-template-columns: 1fr auto auto; gap: .8rem; align-items: center; padding: .75rem 1rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); color: inherit; }
				.ticket-row:hover { box-shadow: var(--shadow-hover); text-decoration: none; }
				.ticket-title { font-weight: 600; }
				.ticket-heading { margin: .4rem 0 1rem; }
				.ticket-columns { display: grid; grid-template-columns: minmax(280px, 380px) 1fr; gap: 1.75rem; align-items: start; }
				.ticket-actions { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; margin: .75rem 0; }
				.revise-form { display: flex; gap: .4rem; flex: 1; min-width: 280px; }
				.plan h4 { margin: .9rem 0 .3rem; font-size: .95rem; color: var(--accent); }
				.plan h4:first-child { margin-top: 0; }
				.plan-text { white-space: pre-wrap; font-size: .9rem; line-height: 1.55; }
				.timeline { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .15rem; }
				.tl-item { display: grid; grid-template-columns: 1.6rem 1fr; gap: .5rem; padding: .45rem .2rem; border-bottom: 1px solid var(--border); }
				.tl-icon { text-align: center; }
				.tl-head { font-size: .75rem; }
				.tl-author { font-weight: 700; color: var(--text-2); }
				.tl-text { font-size: .88rem; }
				.tl-error .tl-text { color: var(--danger); }
				.tl-plan .tl-text { color: var(--accent); font-weight: 600; }
				@media (max-width: 1000px) { .tickets-layout, .ticket-columns { grid-template-columns: 1fr; } }
				/* Diff du développement (jalon 28) : couleurs de VS Code */
				.diff-file { border: 1px solid #2b2b2b; border-radius: 8px; overflow: hidden; margin-bottom: .9rem; }
				.diff-name { background: #252526; color: #cccccc; font: 600 12px Menlo, Monaco, monospace; padding: .4rem .8rem; }
				pre.diff { margin: 0; background: #1e1e1e; color: #d4d4d4; font: 12.5px/1.5 Menlo, Monaco, "SF Mono", monospace; overflow-x: auto; padding: .4rem 0; }
				.diff-line { display: inline-block; min-width: 100%; padding: 0 .8rem; }
				.diff-add { background: rgba(35, 134, 54, .28); color: #aff5b4; }
				.diff-del { background: rgba(218, 54, 51, .28); color: #ffdcd7; }
				.diff-hunk { color: #79c0ff; background: rgba(56, 139, 253, .12); }
				.diff-meta { color: #8b949e; }
				details.report { margin: .5rem 0 1rem; }

				/* Commun */
				h2 { margin-top: 0; }
				h3 { font-size: .95rem; color: var(--text-2); margin-bottom: .3rem; }
				table { border-collapse: collapse; width: 100%; margin: .5rem 0 1.25rem; }
				td, th { border-bottom: 1px solid var(--border); padding: .45rem .6rem; text-align: left; font-size: .86rem; vertical-align: top; }
				th { font-size: .75rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
				tr.needs-review { background: var(--warn-soft); }
				.confidence { font-variant-numeric: tabular-nums; }
				code, .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .85em; }
				.muted { color: var(--muted); font-size: .85rem; }
				/* Architecture (jalon 29). */
				.arch-live { display: inline-flex; align-items: center; gap: .4rem; }
				.live-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 3px var(--ok-soft); }
				.arch-error { border-color: var(--danger); color: var(--danger); }
				.arch-columns { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 1.5rem; align-items: start; }
				.arch-toc { position: sticky; top: calc(var(--header-h) + 1rem); display: flex; flex-direction: column; gap: .15rem; }
				.arch-toc a { color: var(--text-2); font-size: .88rem; padding: .3rem .5rem; border-radius: 6px; }
				.arch-toc a:hover { background: var(--surface-2); text-decoration: none; }
				.arch-doc .card:first-child { margin-top: 0; }
				.md h3 { margin: 0 0 .6rem; font-size: 1.05rem; }
				.md h4 { margin: 1rem 0 .4rem; font-size: .95rem; }
				.md summary { cursor: pointer; }
				.md summary h3 { display: inline; }
				.md ul, .md ol { margin: .3rem 0; padding-left: 1.25rem; }
				.md li { margin: .22rem 0; line-height: 1.5; font-size: .9rem; }
				.md p { margin: .4rem 0; line-height: 1.55; font-size: .9rem; }
				.md pre { background: var(--code-bg); color: var(--code-text); padding: .8rem 1rem; border-radius: 8px; overflow-x: auto; font-size: .8rem; }
				.md del { color: var(--muted); }
				.timeline { display: flex; flex-direction: column; gap: .5rem; }
				.milestone, .commit { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); }
				.milestone > summary, .commit > summary { display: flex; align-items: center; gap: .75rem; padding: .7rem 1rem; cursor: pointer; list-style: none; }
				.milestone > summary::-webkit-details-marker, .commit > summary::-webkit-details-marker { display: none; }
				.milestone[open] > summary, .commit[open] > summary { border-bottom: 1px solid var(--border); }
				.milestone-num { min-width: 3.4rem; font-weight: 700; color: var(--accent); font-variant-numeric: tabular-nums; }
				.milestone-title { flex: 1; font-weight: 600; }
				.milestone .chip { max-width: 34%; overflow: hidden; text-overflow: ellipsis; }
				.milestone-body, .commit-body { padding: .6rem 1.25rem 1rem; }
				.commit-mini { font-size: .86rem; margin: .2rem 0; }
				.commit-list { display: flex; flex-direction: column; gap: .4rem; }
				.commit-hash { color: var(--accent); }
				.commit-subject { flex: 1; font-weight: 550; }
				.commit-meta { white-space: nowrap; }
				.commit-diff { padding: 0 1rem 1rem; }
				.wip { border-color: var(--warn); }
				.wip-head { display: flex; gap: .6rem; align-items: center; }
				.wip-files { margin: .6rem 0 0; padding-left: 1.2rem; font-size: .86rem; columns: 2; }
				.infra-head { display: flex; gap: .75rem; align-items: center; }
				.infra-diagram { overflow-x: auto; padding: .75rem; }
				.infra-diagram svg { display: block; max-width: 100%; height: auto; margin: 0 auto; }
				svg.infra .node rect { fill: var(--surface-2); stroke: var(--border); stroke-width: 1.5; }
				svg.infra .node.up rect { fill: var(--ok-soft); stroke: var(--ok); }
				svg.infra .node.down rect { fill: var(--danger-soft); stroke: var(--danger); stroke-width: 2; }
				svg.infra .node.off rect { stroke-dasharray: 5 4; }
				svg.infra .dot { fill: var(--muted); }
				svg.infra .up .dot { fill: var(--ok); }
				svg.infra .down .dot { fill: var(--danger); }
				svg.infra text { fill: var(--text); font-family: inherit; }
				svg.infra .title { font-size: 14px; font-weight: 700; }
				svg.infra .role { font-size: 11.5px; fill: var(--text-2); }
				svg.infra .detail { font-size: 11px; fill: var(--muted); font-family: ui-monospace, Menlo, monospace; }
				svg.infra .down .detail { fill: var(--danger); }
				svg.infra .edge { fill: none; stroke: var(--muted); stroke-width: 1.4; }
				svg.infra .arrowhead { fill: var(--muted); }
				svg.infra .edge-label { font-size: 11px; fill: var(--text-2); paint-order: stroke; stroke: var(--bg); stroke-width: 4px; }
				.infra-table td.mono { font-size: .8rem; word-break: break-all; }
				@media (max-width: 800px) { .arch-columns { grid-template-columns: 1fr; } .arch-toc { position: static; } .wip-files { columns: 1; } }
			</style>
			<script>
				// Onglets de la vue détail (jalon 22). Délégation sur document :
				// le volet est remplacé par HTMX (fin de traitement, relance),
				// les gestionnaires survivent au remplacement.
				document.addEventListener("click", function (e) {
					var tab = e.target.closest("[data-tab]");
					if (!tab) return;
					var root = tab.closest("[data-tabs]");
					root.querySelectorAll("[data-tab]").forEach(function (t) {
						t.setAttribute("aria-selected", t === tab ? "true" : "false");
					});
					root.querySelectorAll("[data-tab-panel]").forEach(function (p) {
						p.hidden = p.getAttribute("data-tab-panel") !== tab.getAttribute("data-tab");
					});
				});
			</script>
		</head>
		<body>
			<script>
				// Barre latérale repliée ou non : préférence de ce navigateur.
				function jarvisToggleSidebar() {
					var hidden = document.documentElement.classList.toggle("sidebar-hidden");
					try { localStorage.setItem("jarvis.sidebarHidden", hidden ? "1" : ""); } catch (e) {}
				}
				try {
					if (localStorage.getItem("jarvis.sidebarHidden")) { document.documentElement.classList.add("sidebar-hidden"); }
				} catch (e) {}
			</script>
			<header class="app-header">
				if isAdmin(active) {
					<a href="/admin" class="brand"><span class="brand-mark">J</span>Jarvis <span class="admin-badge">Admin</span></a>
					<nav class="app-nav">
						<a href="/admin/agents" class={ templ.KV("active", active == "agents") }>Agents</a>
						<a href="/admin/architecture" class={ templ.KV("active", active == "architecture") }>Architecture</a>
						<a href="/admin/classes" class={ templ.KV("active", active == "classes") }>Classes</a>
						<a href="/admin/model" class={ templ.KV("active", active == "model") }>Modèle</a>
						<a href="/admin/tests" class={ templ.KV("active", active == "tests") }>Tests</a>
					</nav>
					if active == "classes" || active == "tests" || active == "model" {
						<form class="refresh-form" hx-post="/admin/refresh" hx-target="body" hx-swap="outerHTML">
							<button type="submit" class="button-ghost">↻ Rescanner le code</button>
						</form>
					}
					<a href="/" class="space-link">← Application</a>
				} else {
					<a href="/" class="brand"><span class="brand-mark">J</span>Jarvis</a>
					<nav class="app-nav">
						<a href="/" class={ templ.KV("active", active == "upload") }><span class="nav-icon">⬆️</span>Importer</a>
						<a href="/documents" class={ templ.KV("active", active == "documents") }><span class="nav-icon">📄</span>Documents</a>
						<a href="/emails" class={ templ.KV("active", active == "emails") }><span class="nav-icon">📧</span>Emails</a>
						<a href="/notes" class={ templ.KV("active", active == "notes") }><span class="nav-icon">📝</span>Notes</a>
						<a href="/tasks" class={ templ.KV("active", active == "tasks") }><span class="nav-icon">✅</span>Tâches</a>
						<a href="/tickets" class={ templ.KV("active", active == "tickets") }><span class="nav-icon">🎫</span>Tickets</a>
					</nav>
					<button type="button" class="button-ghost sidebar-toggle" title="Afficher / masquer la barre latérale" onclick="jarvisToggleSidebar()">☰</button>
					<a href="/admin" class="space-link" title="Agents, architecture, code et tests">⚙ Admin</a>
				}
			</header>
			if isAdmin(active) {
				{ children... }
			} else {
				// Jalon 34 : barre latérale (tâches de la semaine, en cours,
				// erreurs), chargée à part et rafraîchie toute seule.
				<div class="with-sidebar">
					<div class="main-col">
						{ children... }
					</div>
					<aside class="sidebar" id="sidebar" hx-get="/sidebar" hx-trigger="load, every 15s" hx-swap="innerHTML"></aside>
				</div>
			}
		</body>
	</html>
}
