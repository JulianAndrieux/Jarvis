package templates

templ Layout(title string, active string) {
	<!DOCTYPE html>
	<html lang="fr">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<script src="/static/htmx.min.js"></script>
			<style>
				/* Theme clair uniquement : tous les fonds ci-dessous sont codes en
				   dur (blanc/gris clair). "color-scheme: light dark" sans texte
				   code en dur faisait passer le texte en blanc sur fond blanc en
				   mode sombre systeme -- illisible (cf. cmd/codebrowser). */
				:root { color-scheme: light; }
				body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; margin: 0; padding: 0; background: #f7f7f8; color: #1a1a1a; line-height: 1.5; }
				header { padding: .75rem 1.25rem; border-bottom: 1px solid #8884; display: flex; align-items: center; gap: 1.5rem; background: #fff; }
				header h1 { font-size: 1.1rem; margin: 0; }
				header nav a { margin-right: 1rem; color: inherit; text-decoration: none; font-weight: 600; padding-bottom: .2rem; }
				header nav a.active { border-bottom: 2px solid #48a; }
				header form { margin-left: auto; }
				button { padding: .35rem .8rem; border-radius: 6px; border: 1px solid #8884; cursor: pointer; font-weight: 600; background: #8881; }
				button:hover { background: #8883; }

				/* Page étroite (Upload) : formulaire + résultat centrés, comme
				   avant la fusion (ex-cmd/jarvisweb). */
				.page-narrow { max-width: 860px; margin: 2rem auto; padding: 0 1rem; }
				/* Bibliothèque de documents : liste + aperçu PDF, un peu plus
				   large que la page Upload. */
				.page-wide { max-width: 1100px; margin: 2rem auto; padding: 0 1rem; }
				.card { border: 1px solid #8884; border-radius: 8px; padding: 1rem 1.25rem; margin: 1rem 0; background: #fff; }
				.merged-summary { border-left: 3px solid #48a; padding-left: .9rem; margin: 1rem 0 1.5rem; }
				.merged-summary h3 { margin-top: 0; }
				label { display: block; margin-bottom: .35rem; font-weight: 600; }
				select, input[type=file] { display: block; margin-bottom: 1rem; }
				.status-pending, .status-running { color: #a66; }
				.status-done { color: #2a2; }
				.status-failed { color: #c33; }
				tr.needs-review { background: #fffbe0; }
				.confidence { font-variant-numeric: tabular-nums; }
				.spinner { display: inline-block; width: 1em; height: 1em; border: 2px solid #8886; border-top-color: #555; border-radius: 50%; animation: spin 0.8s linear infinite; vertical-align: -0.15em; margin-right: .4em; }
				@keyframes spin { to { transform: rotate(360deg); } }
				.error-box { background: #fee2; border: 1px solid #c33; border-radius: 6px; padding: .75rem 1rem; color: #a33; }

				/* Pages pleine hauteur, deux volets (Classes) : ex-cmd/codebrowser. */
				main.two-pane { display: flex; height: calc(100vh - 53px); }
				.sidebar { width: 320px; overflow-y: auto; border-right: 1px solid #8884; background: #fff; padding: .75rem; box-sizing: border-box; }
				.detail { flex: 1; overflow-y: auto; padding: 1.25rem 1.5rem; }
				.pkg-group { margin-bottom: .6rem; }
				.pkg-group summary { cursor: pointer; font-weight: 600; font-size: .85rem; color: #666; padding: .2rem 0; }
				.type-link { display: block; padding: .15rem .3rem .15rem 1rem; border-radius: 4px; color: inherit; text-decoration: none; font-size: .92rem; }
				.type-link:hover { background: #8882; }
				.type-link.kind-interface { font-style: italic; }
				.badge { display: inline-block; font-size: .7rem; padding: .05rem .4rem; border-radius: 3px; margin-left: .3rem; vertical-align: middle; }
				.badge-struct { background: #cde; color: #135; }
				.badge-interface { background: #edc; color: #530; }
				.rel-list a { display: inline-block; margin: .15rem .5rem .15rem 0; padding: .1rem .5rem; border-radius: 4px; background: #8882; text-decoration: none; color: inherit; font-size: .85rem; }
				.rel-list a:hover { background: #8884; }

				/* Page de tests (Tests) : ex-cmd/codebrowser. */
				.cat-card { border: 1px solid #8884; border-radius: 8px; padding: .85rem 1.1rem; margin-bottom: 1rem; background: #fff; }
				.cat-card h3 { display: flex; align-items: center; gap: .6rem; font-size: 1rem; color: inherit; margin-top: 0; }
				.test-row { display: flex; align-items: center; gap: .5rem; padding: .2rem 0; border-bottom: 1px solid #8881; font-size: .88rem; }
				.test-row:last-child { border-bottom: none; }
				.test-name { flex: 1; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
				.status-dot { display: inline-block; width: .7em; height: .7em; border-radius: 50%; background: #bbb; flex-shrink: 0; }
				.status-pass .status-dot { background: #2a2; }
				.status-fail .status-dot { background: #c33; }
				.status-skip .status-dot { background: #b90; }
				.status-fail .test-name { color: #a22; }
				.tag { font-size: .7rem; padding: .05rem .4rem; border-radius: 3px; background: #8882; }
				.tag-integration { background: #fd8; color: #740; }
				pre.output { background: #1e1e1e; color: #ddd; padding: .6rem .8rem; border-radius: 6px; overflow-x: auto; font-size: .8rem; margin: .3rem 0; }
				.summary-line { font-size: .85rem; margin: .4rem 0 .7rem; }

				/* Commun aux deux styles de page. */
				h2 { margin-top: 0; }
				h3 { font-size: .95rem; color: #555; margin-bottom: .3rem; }
				table { border-collapse: collapse; width: 100%; margin: .5rem 0 1.25rem; }
				td, th { border: 1px solid #8884; padding: .35rem .55rem; text-align: left; font-size: .88rem; }
				code, .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .85em; }
				.muted { color: #888; font-size: .85rem; }
			</style>
		</head>
		<body>
			<header>
				<h1>Jarvis</h1>
				<nav>
					<a href="/" class={ templ.KV("active", active == "upload") }>Upload</a>
					<a href="/documents" class={ templ.KV("active", active == "documents") }>Documents</a>
					<a href="/classes" class={ templ.KV("active", active == "classes") }>Classes</a>
					<a href="/tests" class={ templ.KV("active", active == "tests") }>Tests</a>
				</nav>
				<form hx-post="/refresh" hx-target="body" hx-swap="outerHTML">
					<button type="submit">↻ Rescanner le code</button>
				</form>
			</header>
			{ children... }
		</body>
	</html>
}
