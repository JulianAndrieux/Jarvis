package templates

import (
	"fmt"

	"github.com/JulianAndrieux/Jarvis/internal/tickets"
)

templ TicketsPage(list []tickets.Ticket) {
	@Layout("Jarvis — tickets", "tickets") {
		<div class="page-wide tickets-page">
			<div class="page-title">
				<h2>Tickets</h2>
				<span class="muted">Décris un changement ; l'agent local l'analyse et propose un plan à valider.</span>
			</div>
			<div class="tickets-layout">
				<form class="card ticket-form" method="post" action="/tickets">
					<label for="title">Titre</label>
					<input type="text" id="title" name="title" required placeholder="Ex. Filtrer les documents par date d'import"/>
					<label for="need">Ce que je veux</label>
					<textarea id="need" name="need" rows="6" placeholder="Décris le besoin, le contexte, ce qui te gêne aujourd'hui…"></textarea>
					<label for="acceptance">Critères d'acceptation (un par ligne)</label>
					<textarea id="acceptance" name="acceptance" rows="4" placeholder="Ex. /documents?since=2026-09-01 ne liste que les documents importés depuis cette date"></textarea>
					<button type="submit" class="button-primary">Créer le ticket</button>
				</form>
				<div class="ticket-list">
					if len(list) == 0 {
						<div class="empty-state"><p>Aucun ticket pour l'instant.</p></div>
					}
					for _, t := range list {
						<a class="ticket-row" href={ templ.SafeURL("/tickets/" + t.ID) }>
							<span class="ticket-title">{ t.Title }</span>
							<span class={ ticketChipClass(t.Status) }>{ t.Status.Label() }</span>
							<span class="muted">{ t.CreatedAt.Local().Format("02/01/2006 15:04") }</span>
						</a>
					}
				</div>
			</div>
		</div>
	}
}

templ TicketPage(t tickets.Ticket, a TicketActions) {
	@Layout("Jarvis — " + t.Title, "tickets") {
		<div class="page-wide ticket-page">
			<a class="panel-back" href="/tickets">← Tickets</a>
			<h2 class="ticket-heading">{ t.Title }</h2>
			<div class="ticket-columns">
				<div>
					<div class="section-title">Besoin</div>
					<div class="card plan-text">{ t.Need }</div>
					if t.Acceptance != "" {
						<div class="section-title">Critères d'acceptation</div>
						<div class="card plan-text">{ t.Acceptance }</div>
					}
					<div class="section-title">Commentaire</div>
					<form hx-post={ "/tickets/" + t.ID + "/comment" } hx-target="#ticket-panel" hx-swap="outerHTML" hx-on::after-request="this.reset()">
						<textarea name="text" rows="3" placeholder="Une précision pour l'agent (prise en compte à la prochaine révision)…"></textarea>
						<button type="submit">Ajouter</button>
					</form>
					<div class="section-title">Zone dangereuse</div>
					<button class="button-danger" hx-delete={ "/tickets/" + t.ID } hx-confirm="Supprimer définitivement ce ticket ?">Supprimer le ticket</button>
				</div>
				@TicketPanel(t, a)
			</div>
		</div>
	}
}

// TicketPanel : statut, actions, plan et fil de l'agent. Se sonde lui-même
// pendant que l'agent travaille ou que le déploiement a lieu.
templ TicketPanel(t tickets.Ticket, a TicketActions) {
	if t.Status.Active() {
		<div id="ticket-panel" class="ticket-panel" hx-get={ "/tickets/" + t.ID + "/panel" } hx-trigger="load delay:2s" hx-swap="outerHTML">
			@ticketPanelBody(t, a)
		</div>
	} else {
		<div id="ticket-panel" class="ticket-panel">
			@ticketPanelBody(t, a)
		</div>
	}
}

templ ticketPanelBody(t tickets.Ticket, a TicketActions) {
	<div class="ticket-status">
		<span class={ ticketChipClass(t.Status) }>
			if t.Status.Active() {
				<span class="spinner"></span>
			}
			{ t.Status.Label() }
		</span>
	</div>
	<div class="ticket-actions">
		switch t.Status {
			case tickets.Draft:
				<button class="button-primary" hx-post={ "/tickets/" + t.ID + "/analyze" } hx-target="#ticket-panel" hx-swap="outerHTML">🤖 Lancer l'analyse</button>
			case tickets.Failed:
				if t.Branch != "" {
					<button class="button-primary" hx-post={ "/tickets/" + t.ID + "/develop" } hx-target="#ticket-panel" hx-swap="outerHTML">↻ Relancer le développement</button>
				}
				<button hx-post={ "/tickets/" + t.ID + "/analyze" } hx-target="#ticket-panel" hx-swap="outerHTML">↻ Relancer l'analyse</button>
			case tickets.Analyzing:
				<p class="muted">L'agent explore le code et prépare un plan — le fil ci-dessous se met à jour en direct.</p>
			case tickets.Developing:
				<p class="muted">L'agent développe dans une copie isolée (branche { "ticket/" + t.ID }) : tests d'abord, puis Jarvis refait toute la vérification. Le fil se met à jour en direct.</p>
			case tickets.Review:
				if a.Deploy {
					<button class="button-primary" hx-post={ "/tickets/" + t.ID + "/accept" } hx-target="#ticket-panel" hx-swap="outerHTML" hx-confirm="Fusionner ce diff dans main et redémarrer l'application sur la nouvelle version ?">🚀 Accepter et déployer</button>
				} else {
					<button class="button-primary" hx-post={ "/tickets/" + t.ID + "/accept" } hx-target="#ticket-panel" hx-swap="outerHTML">✓ Accepter le diff</button>
				}
				<form class="revise-form" hx-post={ "/tickets/" + t.ID + "/changes" } hx-target="#ticket-panel" hx-swap="outerHTML">
					<input type="text" name="feedback" placeholder="Ce qu'il faut changer dans le code…"/>
					<button type="submit">Demander des changements</button>
				</form>
			case tickets.Accepted:
				<p class="warn-box">Diff accepté sans déploiement (branche { t.Branch }) : main n'a pas changé.</p>
				if a.Deploy && t.Branch != "" {
					<button class="button-primary" hx-post={ "/tickets/" + t.ID + "/deploy" } hx-target="#ticket-panel" hx-swap="outerHTML" hx-confirm="Fusionner ce diff dans main et redémarrer l'application sur la nouvelle version ?">🚀 Déployer</button>
				}
			case tickets.Deploying:
				<p class="muted">Déploiement : intégration de main dans la branche, vérification complète, compilation, essai à blanc de la nouvelle version — main n'avance qu'ensuite, puis l'application redémarre (quelques secondes d'indisponibilité). Si la nouvelle version ne démarre pas, l'ancienne est rétablie. Le fil se met à jour en direct.</p>
			case tickets.Deployed:
				<p class="ok-box">Déployé : le changement est dans main et l'application tourne sur la nouvelle version.</p>
				@pushBlock(t, a)
			case tickets.PlanReady:
				<button class="button-primary" hx-post={ "/tickets/" + t.ID + "/approve" } hx-target="#ticket-panel" hx-swap="outerHTML">✓ Valider le plan</button>
				<form class="revise-form" hx-post={ "/tickets/" + t.ID + "/revise" } hx-target="#ticket-panel" hx-swap="outerHTML">
					<input type="text" name="feedback" placeholder="Ce qu'il faut changer dans le plan…"/>
					<button type="submit">Demander une révision</button>
				</form>
			case tickets.PlanApproved:
				<p class="warn-box">Plan validé. Le développement automatique n'est pas configuré sur cette instance.</p>
		}
		if t.Status == tickets.Draft || t.Status == tickets.PlanReady || t.Status == tickets.Failed || t.Status == tickets.PlanApproved || t.Status == tickets.Review {
			<button class="button-ghost" hx-post={ "/tickets/" + t.ID + "/cancel" } hx-target="#ticket-panel" hx-swap="outerHTML">Annuler le ticket</button>
		}
	</div>
	if t.Review != nil {
		@reviewBlock(*t.Review)
	}
	if t.Diff != "" {
		<div class="section-title">Diff (branche { t.Branch })</div>
		@renderDiff(t.Diff)
	}
	if t.Report != "" {
		<details class="raw report">
			<summary>Rapport de vérification (gofmt, vet, build, tests)</summary>
			<pre>{ t.Report }</pre>
		</details>
	}
	if t.Plan != "" {
		<div class="section-title">Plan de l'agent</div>
		<div class="card plan">
			@renderPlan(t.Plan)
		</div>
	}
	<div class="section-title">Fil du ticket</div>
	<ol class="timeline">
		for _, e := range t.Events {
			<li class={ "tl-item", "tl-" + string(e.Kind) }>
				<span class="tl-icon">{ eventIcon(e) }</span>
				<div class="tl-body">
					<div class="tl-head"><span class="tl-author">{ string(e.Author) }</span> <span class="muted">{ e.At.Local().Format("15:04:05") }</span></div>
					<div class="tl-text">{ e.Text }</div>
					if e.Detail != "" {
						<details class="raw">
							<summary>Voir la sortie</summary>
							<pre>{ e.Detail }</pre>
						</details>
					}
				</div>
			</li>
		}
	</ol>
}

// pushBlock : ce qui partira vers GitHub, et le bouton pour l'envoyer.
templ pushBlock(t tickets.Ticket, a TicketActions) {
	if !a.PushKnown {
		<p class="muted">main n'est pas poussé automatiquement vers GitHub : <code>git push</code> quand tu veux.</p>
	} else if a.UnpushedErr != "" {
		<p class="warn-box">État de GitHub inconnu : { a.UnpushedErr }</p>
	}
	if a.PushKnown && len(a.Unpushed) > 0 {
		<div class="push-block">
			<div class="section-title">{ fmt.Sprint(len(a.Unpushed)) } commit(s) de main pas encore sur GitHub</div>
			<ul class="push-commits">
				for _, c := range a.Unpushed {
					<li><code>{ c }</code></li>
				}
			</ul>
			if a.Push {
				<button class="button-primary" hx-post={ "/tickets/" + t.ID + "/push" } hx-target="#ticket-panel" hx-swap="outerHTML" hx-disabled-elt="this" hx-confirm={ fmt.Sprintf("Pousser main vers GitHub ? Les %d commit(s) listés partiront (jamais de push forcé).", len(a.Unpushed)) }>⬆ Pousser vers GitHub</button>
			} else {
				<p class="muted">Push depuis l'application non configuré : <code>git push</code> depuis le dépôt.</p>
			}
		</div>
	} else if t.Pushed != "" {
		<p class="ok-box">Poussé vers GitHub (origin/main à <code>{ shortHash(t.Pushed) }</code>).</p>
	} else if a.PushKnown && a.UnpushedErr == "" {
		<p class="muted">main est à jour sur GitHub.</p>
	}
}

// reviewBlock : le verdict du relecteur (jalon 36), avant le diff. Texte
// écrit par un modèle : tout est échappé.
templ reviewBlock(r tickets.ReviewResult) {
	<div class="section-title">Relecture</div>
	<div class={ "card", "review-block", templ.KV("review-ok", r.Approved) }>
		<p class="review-verdict">
			if r.Approved {
				✅ Acceptable pour le relecteur
			} else if len(r.Issues) > 0 {
				⚠️ Points restants — à ta décision
			} else {
				⚠️ { r.Summary }
			}
			<span class="muted"> · { fmt.Sprint(r.Rounds) } relecture(s)</span>
		</p>
		if r.Summary != "" && (r.Approved || len(r.Issues) > 0) {
			<p>{ r.Summary }</p>
		}
		if len(r.Issues) > 0 {
			<ul class="review-issues">
				for _, i := range r.Issues {
					<li>
						<span class={ "chip", templ.KV("chip-failed", i.Severity == "bloquant"), templ.KV("chip-review", i.Severity != "bloquant") }>{ i.Severity }</span>
						<code>{ issueLocation(i) }</code>
						{ i.Message }
					</li>
				}
			</ul>
		}
	</div>
}
