package templates

import (
	"fmt"
	"strings"

	"github.com/JulianAndrieux/Jarvis/internal/formats"
	"github.com/JulianAndrieux/Jarvis/internal/webapp"
)

// DocumentRow est l'entrée d'un document dans la bibliothèque (jalon 17),
// affichée en carte avec miniature depuis le jalon 22.
type DocumentRow struct {
	ID        string
	Filename  string
	DocType   string
	Status    string
	Tags      []string
	CreatedAt string // pré-formaté (le formatage de date reste une préoccupation d'affichage, pas de vue)
	// Jalon 25 : famille du fichier, extension affichée en badge, et si
	// une miniature peut exister (sinon : icône).
	Family       formats.Family
	Ext          string
	HasThumbnail bool
}

// TypeFilter est un filtre par type de la bibliothèque.
type TypeFilter struct {
	Value  string // famille ("" : tous)
	Label  string
	Active bool
}

// familyIcon : icône d'un fichier sans miniature (ou en attendant la
// sienne).
func familyIcon(f formats.Family) string {
	switch f {
	case formats.PDF:
		return "📕"
	case formats.Word:
		return "📝"
	case formats.Slides:
		return "📊"
	case formats.Sheet:
		return "📗"
	case formats.CSV:
		return "🧾"
	case formats.Text:
		return "📄"
	case formats.HTML:
		return "🌐"
	case formats.Image:
		return "🖼️"
	case formats.Email:
		return "✉️"
	default:
		return "📦"
	}
}

func filterURL(value, search string) string {
	u := "/documents"
	sep := "?"
	if value != "" {
		u += sep + "type=" + value
		sep = "&"
	}
	if search != "" {
		u += sep + "q=" + search
	}
	return u
}

templ DocumentsPage(docs []DocumentRow, search string, filters []TypeFilter) {
	@Layout("Jarvis — documents", "documents") {
		<div class="page-wide">
			<div class="page-title">
				<h2>Documents</h2>
				<a class="button button-primary" href="/">+ Importer</a>
			</div>
			<form class="search-bar" method="get" action="/documents">
				<input type="text" name="q" id="q" value={ search } placeholder="Rechercher : nom, type, tag, ou contenu du document…"/>
				for _, f := range filters {
					if f.Active && f.Value != "" {
						<input type="hidden" name="type" value={ f.Value }/>
					}
				}
				<button type="submit">Rechercher</button>
			</form>
			<div class="type-filters">
				for _, f := range filters {
					<a class={ "chip", "filter-chip", templ.KV("active", f.Active) } href={ templ.SafeURL(filterURL(f.Value, search)) }>{ f.Label }</a>
				}
			</div>
			if len(docs) == 0 {
				<div class="empty-state">
					if search != "" {
						<p>Aucun document ne correspond à « { search } ».</p>
					} else {
						<p>Aucun document pour l'instant.</p>
						<a class="button button-primary" href="/">Importer un premier PDF</a>
					}
				</div>
			} else {
				<p class="muted">{ fmt.Sprint(len(docs)) } document(s)</p>
				<div class="doc-grid">
					for _, d := range docs {
						<a class="doc-card" href={ templ.SafeURL("/documents/" + d.ID) }>
							<div class="doc-thumb">
								if d.HasThumbnail {
									<img src={ "/documents/" + d.ID + "/thumbnail" } alt={ "Aperçu de " + d.Filename } loading="lazy" onerror="this.hidden=true;this.nextElementSibling.hidden=false"/>
								}
								<div class="doc-icon" hidden?={ d.HasThumbnail }>{ familyIcon(d.Family) }</div>
								if d.Ext != "" {
									<span class="ext-badge">{ d.Ext }</span>
								}
							</div>
							<div class="doc-card-body">
								<div class="doc-name" title={ d.Filename }>{ d.Filename }</div>
								<div class="doc-meta">
									if d.DocType != "" {
										<span class="chip chip-type">{ d.DocType }</span>
									}
									if d.Status != string(webapp.StatusDone) {
										@statusChip(webapp.Status(d.Status))
									}
									for _, tag := range d.Tags {
										<span class="chip">{ tag }</span>
									}
								</div>
								<div class="doc-date">{ d.CreatedAt }</div>
							</div>
							<button
								class="button-danger card-delete"
								title="Supprimer"
								hx-delete={ "/documents/" + d.ID }
								hx-confirm={ "Supprimer définitivement " + d.Filename + " ?" }
								onclick="event.preventDefault()"
							>🗑</button>
						</a>
					}
				</div>
			}
		</div>
	}
}

// DocumentDetailPage : aperçu du PDF à gauche, toutes les informations à
// droite (jalon 22). Le volet droit (DocumentPanel) est un fragment
// autonome : il se sonde lui-même tant que le traitement tourne, et la
// relance d'extraction le remplace en place.
templ DocumentDetailPage(job webapp.Job, view ResultView, docTypes []string) {
	@Layout("Jarvis — " + job.Filename, "documents") {
		<div class="doc-shell">
			<section class="doc-preview">
				@previewPane(job)
			</section>
			@DocumentPanel(job, view, docTypes)
		</div>
	}
}

func fileFamily(job webapp.Job) formats.Family {
	if job.Format == "" {
		return formats.PDF
	}
	return formats.Family(job.Format)
}

func fileExtLabel(filename string) string {
	if i := strings.LastIndex(filename, "."); i > 0 && i < len(filename)-1 {
		return strings.ToUpper(filename[i+1:])
	}
	return ""
}

// HumanSize : taille lisible ("1,2 Mo").
func HumanSize(n int64) string {
	switch {
	case n >= 1<<30:
		return strings.Replace(fmt.Sprintf("%.1f Go", float64(n)/(1<<30)), ".", ",", 1)
	case n >= 1<<20:
		return strings.Replace(fmt.Sprintf("%.1f Mo", float64(n)/(1<<20)), ".", ",", 1)
	case n >= 1<<10:
		return fmt.Sprintf("%d Ko", n>>10)
	default:
		return fmt.Sprintf("%d o", n)
	}
}

// previewReady : l'aperçu d'une famille qui passe par la conversion
// (Word, tableur, présentation, image HEIC/TIFF) n'existe qu'une fois le
// traitement terminé ; les autres (PDF, texte, CSV, page web, e-mail,
// image affichable) se lisent directement dans l'original.
func previewReady(job webapp.Job) bool {
	if job.Status != webapp.StatusPending && job.Status != webapp.StatusRunning {
		return true
	}
	switch fileFamily(job) {
	case formats.Word, formats.Slides, formats.Sheet:
		return false
	case formats.Image:
		return formats.BrowserDisplayable(job.MIME)
	}
	return true
}

func documentMeta(job webapp.Job, view ResultView) []string {
	meta := []string{"Importé le " + job.CreatedAt.Local().Format("02/01/2006 à 15:04")}
	if job.Size > 0 {
		meta = append(meta, HumanSize(job.Size))
	}
	if view.PageCount > 0 {
		meta = append(meta, fmt.Sprintf("%d page(s)", view.PageCount))
	}
	if job.Status == webapp.StatusDone || job.Status == webapp.StatusFailed {
		if !job.StartedAt.IsZero() && !job.FinishedAt.IsZero() {
			meta = append(meta, "traité en "+job.FinishedAt.Sub(job.StartedAt).Round(1e9).String())
		}
	}
	return meta
}

// previewPane : l'aperçu adapté à chaque famille de fichier (jalon 25).
// Les aperçus natifs (/view) viennent de contenu fourni par
// l'utilisateur : iframe en bac à sable, en plus de la CSP du serveur.
templ previewPane(job webapp.Job) {
	if !previewReady(job) {
		<div class="preview-placeholder">
			<div class="doc-icon">{ familyIcon(fileFamily(job)) }</div>
			<p>Aperçu disponible dès la fin de la conversion…</p>
		</div>
	} else {
		switch fileFamily(job) {
			case formats.Image:
				<div class="preview-image-wrap">
					<img class="preview-image" src={ "/documents/" + job.ID + "/image" } alt={ job.Filename }/>
				</div>
			case formats.Sheet, formats.CSV, formats.Text, formats.HTML, formats.Email:
				<div class="preview-stack">
					<iframe sandbox="" src={ "/documents/" + job.ID + "/view" } title={ "Aperçu de " + job.Filename }></iframe>
					<a class="preview-alt" href={ templ.SafeURL("/documents/" + job.ID + "/pdf") } target="_blank">Version PDF ↗</a>
				</div>
			case formats.Other:
				<div class="preview-placeholder">
					<div class="doc-icon">{ familyIcon(formats.Other) }</div>
					<p><strong>{ job.Filename }</strong></p>
					<p class="muted">{ HumanSize(job.Size) } · Aperçu indisponible pour ce type de fichier.</p>
					<a class="button button-primary" href={ templ.SafeURL("/documents/" + job.ID + "/original") }>Télécharger</a>
				</div>
			default:
				<iframe src={ "/documents/" + job.ID + "/pdf#view=FitH" } title={ "Aperçu de " + job.Filename }></iframe>
		}
	}
}

templ DocumentPanel(job webapp.Job, view ResultView, docTypes []string) {
	if job.Status == webapp.StatusPending || job.Status == webapp.StatusRunning {
		<section class="doc-panel" id="doc-panel" hx-get={ "/documents/" + job.ID + "/panel" } hx-trigger="load delay:2s" hx-swap="outerHTML">
			@panelHeader(job, view)
			<div class="card">
				<p class={ "status-" + string(job.Status) }><span class="spinner"></span> { statusLabel(job.Status) }…</p>
				if view.Progress != nil {
					@progressBlock(view.Progress)
				}
				<p class="muted">{ formatStarted(job) } — la page se met à jour automatiquement.</p>
			</div>
			if len(view.OCRPages) > 0 {
				<div class="section-title">Texte déjà lu</div>
				@ocrPageList(view.OCRPages)
			}
		</section>
	} else {
		<section class="doc-panel" id="doc-panel" data-tabs>
			@panelHeader(job, view)
			// Hors des onglets : visible dès l'ouverture du document.
			<div class="card" id="comment-section">
				@CommentForm(job.ID, job.Comment, false)
			</div>
			<nav class="tabs" role="tablist">
				<button class="tab" role="tab" data-tab="data" aria-selected="true">Données</button>
				<button class="tab" role="tab" data-tab="ocr" aria-selected="false">Texte OCR <span class="count">{ fmt.Sprint(len(view.OCRPages)) }</span></button>
				<button class="tab" role="tab" data-tab="llm" aria-selected="false">Analyse LLM <span class="count">{ fmt.Sprint(len(view.Pages)) }</span></button>
				<button class="tab" role="tab" data-tab="info" aria-selected="false">Infos</button>
			</nav>
			<div class="tab-panel" data-tab-panel="data">
				@dataTab(job, view)
			</div>
			<div class="tab-panel" data-tab-panel="ocr" hidden>
				@ocrTab(view)
			</div>
			<div class="tab-panel" data-tab-panel="llm" hidden>
				@llmTab(view)
			</div>
			<div class="tab-panel" data-tab-panel="info" hidden>
				@infoTab(job, view, docTypes)
			</div>
		</section>
	}
}

templ panelHeader(job webapp.Job, view ResultView) {
	<a class="panel-back" href="/documents">← Documents</a>
	<h1 class="panel-title">{ job.Filename }</h1>
	<div class="panel-badges">
		<span class="chip">{ fileFamily(job).Label() }</span>
		if job.DocType != "" {
			<span class="chip chip-type">{ job.DocType }</span>
		}
		@statusChip(job.Status)
		if job.Status == webapp.StatusDone && view.Merged.NeedsReview {
			<span class="chip chip-review">⚠ à revoir</span>
		}
		if view.ClassificationConfidence > 0 {
			<span class="chip">classification { confidencePct(view.ClassificationConfidence) }</span>
		}
		if job.Result != nil {
			if view.HasTextLayer {
				<span class="chip">texte natif</span>
			} else {
				<span class="chip">scanné</span>
			}
		}
	</div>
	<div class="panel-meta">
		for _, m := range documentMeta(job, view) {
			<span>{ m }</span>
		}
	</div>
	<div class="panel-actions">
		<a class="button" href={ templ.SafeURL("/documents/" + job.ID + "/original") }>⬇ Télécharger l'original</a>
	</div>
}

templ dataTab(job webapp.Job, view ResultView) {
	if fileFamily(job) == formats.Other && job.Status == webapp.StatusDone {
		<p class="muted">Fichier stocké tel quel : pas d'aperçu ni d'extraction de données pour ce type de fichier. Il reste téléchargeable et retrouvable par son nom et ses tags.</p>
	} else if job.Status == webapp.StatusFailed {
		<div class="error-box">{ job.Err }</div>
	} else if view.DocType == "" {
		<p class="warn-box">
			⚠ Aucun type de document reconnu (confiance { fmt.Sprintf("%.2f", view.ClassificationConfidence) }) —
			pas d'extraction possible. Choisis un type dans l'onglet Infos pour lancer l'extraction.
		</p>
	} else if view.Merged.Failed {
		<div class="error-box">{ view.Merged.Error }</div>
	} else {
		if view.Merged.NeedsReview {
			<p class="warn-box">⚠ Un ou plusieurs champs sont sous le seuil de confiance — à vérifier sur l'aperçu.</p>
		}
		@FieldList(view.Merged.Fields)
		<p class="muted">Fusion de toutes les pages (meilleure confiance par champ). Détail par page : onglet Analyse LLM.</p>
	}
}

templ ocrTab(view ResultView) {
	if view.NativeTextMissing {
		<p class="warn-box">
			Ce document a été traité avant que le texte des pages natives soit conservé : seules les pages passées par le VLM sont affichées.
			Relancer l'extraction (onglet Infos) enregistre le texte de toutes les pages.
		</p>
	}
	if len(view.OCRPages) == 0 {
		<p class="muted">Aucun texte disponible pour ce document.</p>
	}
	@ocrPageList(view.OCRPages)
}

templ ocrPageList(pages []OCRPageView) {
	for _, p := range pages {
		<div class="page-block">
			<div class="page-block-head">
				<strong>Page { fmt.Sprint(p.Page) }</strong>
				<span class="chip">{ p.Source }</span>
				if p.Model != "" {
					<span class="model">{ p.Model }</span>
				}
			</div>
			if p.Failed {
				<div class="page-block-body"><div class="error-box">{ p.Error }</div></div>
			} else {
				<pre class="ocr-text">{ p.Text }</pre>
			}
		</div>
	}
}

templ llmTab(view ResultView) {
	if len(view.Pages) == 0 {
		<p class="muted">Aucune analyse LLM pour ce document.</p>
	}
	for _, p := range view.Pages {
		<div class="page-block">
			<div class="page-block-head">
				<strong>Page { fmt.Sprint(p.Page) }</strong>
				if p.Model != "" {
					<span class="model">{ p.Model }</span>
				}
				if p.Failed {
					<span class="chip chip-failed">échec</span>
				} else if p.NeedsReview {
					<span class="chip chip-review">⚠ à revoir</span>
				}
			</div>
			<div class="page-block-body">
				if p.Failed {
					<div class="error-box">{ p.Error }</div>
				} else {
					@FieldList(p.Fields)
				}
				if p.Prompt != "" {
					<details class="raw">
						<summary>Prompt envoyé au LLM</summary>
						<pre>{ p.Prompt }</pre>
					</details>
				}
				if p.RawJSON != "" {
					<details class="raw">
						<summary>Réponse JSON brute</summary>
						<pre>{ p.RawJSON }</pre>
					</details>
				}
			</div>
		</div>
	}
}

templ infoTab(job webapp.Job, view ResultView, docTypes []string) {
	<div class="section-title">Tags</div>
	<div id="tags-section">
		@TagsForm(job.ID, job.Tags)
	</div>
	<div class="section-title">Type de document</div>
	<form hx-post={ "/documents/" + job.ID + "/reprocess" } hx-target="#doc-panel" hx-swap="outerHTML">
		<label for="doc_type">Changer le type relance l'extraction</label>
		<div class="field-row">
			<select name="doc_type" id="doc_type">
				for _, dt := range docTypes {
					<option value={ dt } selected?={ dt == job.DocType }>{ dt }</option>
				}
			</select>
			<button type="submit">Ré-extraire</button>
		</div>
	</form>
	<div class="section-title">Traitement</div>
	<dl class="info-grid">
		<dt>Statut</dt>
		<dd>{ statusLabel(job.Status) }</dd>
		if d := formatDuration(job); d != "" {
			<dt>Durée</dt>
			<dd>{ d }</dd>
		}
		if job.Result != nil {
			<dt>Triage</dt>
			<dd>score { fmt.Sprintf("%.2f", view.TriageScore) }, couche texte native { yesNo(view.HasTextLayer) }</dd>
		}
		<dt>Identifiant</dt>
		<dd class="mono">{ job.ID }</dd>
		<dt>Stockage</dt>
		<dd>✓ Enregistré dans MongoDB (PDF, texte OCR et analyse LLM)</dd>
	</dl>
	<div class="section-title">Zone dangereuse</div>
	<div class="card danger-zone">
		<button
			class="button-danger"
			hx-delete={ "/documents/" + job.ID }
			hx-confirm={ "Supprimer définitivement " + job.Filename + " ? Cette action est irréversible." }
		>
			Supprimer ce document
		</button>
	</div>
}

// CommentForm : commentaire libre sur le document, trouvé par la barre
// de recherche. saved affiche la confirmation après un enregistrement.
templ CommentForm(jobID, comment string, saved bool) {
	<form hx-post={ "/documents/" + jobID + "/comment" } hx-target="#comment-section" hx-swap="innerHTML">
		<label for="comment">Commentaire — ses mots sont trouvés par la recherche</label>
		<textarea name="comment" id="comment" rows="4">{ comment }</textarea>
		<div class="field-row comment-actions">
			<button type="submit">Enregistrer</button>
			if saved {
				<span class="muted">✓ Enregistré</span>
			}
		</div>
	</form>
}

templ TagsForm(jobID string, tags []string) {
	<form hx-post={ "/documents/" + jobID + "/tags" } hx-target="#tags-section" hx-swap="innerHTML">
		<label for="tags">Séparés par des virgules</label>
		<div class="field-row">
			<input type="text" name="tags" id="tags" value={ strings.Join(tags, ", ") }/>
			<button type="submit">Enregistrer</button>
		</div>
	</form>
}
