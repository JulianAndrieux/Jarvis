package templates

import "fmt"

// TypeSummary est l'entrée d'un type dans la barre latérale.
type TypeSummary struct {
	Name string
	Kind string // "struct" | "interface" | "other"
}

// PackageSummary regroupe les types d'un package pour la barre latérale.
// Label est le chemin relatif au module (jalon 24), Path le chemin
// d'import complet (utilisé dans les liens).
type PackageSummary struct {
	Path  string
	Label string
	Types []TypeSummary
}

type FieldInfoView struct {
	Name      string
	Type      string
	Tag       string
	Anonymous bool
	Exported  bool
	// Links : types du module référencés par le champ (cliquables).
	Links []RefView
}

type MethodView struct {
	Name            string
	Signature       string // sans le "func" initial : "(ctx context.Context) error"
	PointerReceiver bool
	Exported        bool
	Code            CodeView
}

type RefView struct {
	Package      string
	Name         string
	PackageLabel string
}

// TypeDetailView est la fiche d'un type : UML, relations, code source.
type TypeDetailView struct {
	Name          string
	Package       string
	PackageLabel  string
	Kind          string
	Fields        []FieldInfoView
	Methods       []MethodView
	Embeds        []RefView
	EmbeddedBy    []RefView
	Implements    []RefView
	ImplementedBy []RefView
	ReferencedBy  []RefView
	Code          CodeView
}

// classURL : page Classes complète (lien normal, marche sans HTMX).
func classURL(pkg, name string) string {
	return fmt.Sprintf("/classes?pkg=%s&name=%s", pkg, name)
}

// typeLink : fragment de détail, chargé par HTMX dans la page Classes.
func typeLink(pkg, name string) string {
	return fmt.Sprintf("/classes/detail?pkg=%s&name=%s", pkg, name)
}

func modelURL(pkg, name string) string {
	return fmt.Sprintf("/model?pkg=%s&name=%s", pkg, name)
}

func visibility(exported bool) string {
	if exported {
		return "+"
	}
	return "-"
}

func stereotype(kind string) string {
	switch kind {
	case "interface":
		return "«interface»"
	case "struct":
		return "«struct»"
	default:
		return "«type»"
	}
}

templ ClassesPage(packages []PackageSummary, selected *TypeDetailView) {
	@Layout("Jarvis — classes", "classes") {
		<main class="two-pane">
			<div class="sidebar">
				<input type="text" class="sidebar-filter" placeholder="Filtrer les types…" oninput="filterTypes(this.value)"/>
				for _, pkg := range packages {
					<details class="pkg-group" open>
						<summary>{ pkg.Label }</summary>
						for _, t := range pkg.Types {
							<a
								class={ "type-link", templ.KV("kind-interface", t.Kind == "interface") }
								data-name={ t.Name }
								href={ templ.SafeURL(classURL(pkg.Path, t.Name)) }
								hx-get={ typeLink(pkg.Path, t.Name) }
								hx-target="#detail"
								hx-push-url={ classURL(pkg.Path, t.Name) }
							>
								<span class={ "kind-dot", "kind-" + t.Kind }></span>
								{ t.Name }
							</a>
						}
					</details>
				}
				<script>
					function filterTypes(q) {
						q = q.toLowerCase();
						document.querySelectorAll(".sidebar .pkg-group").forEach(function (g) {
							var any = false;
							g.querySelectorAll(".type-link").forEach(function (a) {
								var ok = a.dataset.name.toLowerCase().indexOf(q) >= 0;
								a.style.display = ok ? "" : "none";
								any = any || ok;
							});
							g.style.display = any ? "" : "none";
						});
					}
				</script>
			</div>
			<div class="detail" id="detail">
				if selected != nil {
					@TypeDetail(*selected)
				} else {
					<div class="empty-state">
						<p>Choisis un type dans la liste à gauche,</p>
						<a class="button" href="/model">ou explore le modèle de données →</a>
					</div>
				}
			</div>
		</main>
	}
}

templ TypeDetail(d TypeDetailView) {
	<div class="type-page">
		<div class="type-head">
			<div>
				<h2>{ d.Name }</h2>
				<div class="muted mono">{ d.PackageLabel }</div>
			</div>
			<a class="button" href={ templ.SafeURL(modelURL(d.Package, d.Name)) }>Voir dans le modèle de données →</a>
		</div>
		<div class="type-overview">
			@UMLCard(d)
			@Relations(d)
		</div>
		if len(d.Code.Lines) > 0 {
			<div class="section-title">Déclaration</div>
			@CodeBlock(d.Code)
		}
		for _, m := range d.Methods {
			if len(m.Code.Lines) > 0 {
				<div class="section-title">Méthode { m.Name }</div>
				@CodeBlock(m.Code)
			}
		}
	</div>
}

// UMLCard est la fiche du type en notation UML : stéréotype, nom,
// package, attributs (champs) et opérations (méthodes).
templ UMLCard(d TypeDetailView) {
	<div class={ "uml", "uml-" + d.Kind }>
		<div class="uml-head">
			<div class="uml-stereo">{ stereotype(d.Kind) }</div>
			<div class="uml-name">{ d.Name }</div>
			<div class="uml-pkg">{ d.PackageLabel }</div>
		</div>
		if d.Kind != "interface" {
			<div class="uml-section">
				if len(d.Fields) == 0 {
					<div class="uml-empty">aucun champ</div>
				}
				for _, f := range d.Fields {
					<div class={ "uml-row", templ.KV("uml-embed", f.Anonymous) }>
						<span class="uml-vis">{ visibility(f.Exported) }</span>
						<span class="uml-member">{ f.Name }</span>
						<span class="uml-type">
							if len(f.Links) == 1 {
								<a href={ templ.SafeURL(classURL(f.Links[0].Package, f.Links[0].Name)) }>{ f.Type }</a>
							} else {
								{ f.Type }
								for _, l := range f.Links {
									<a class="uml-ref" href={ templ.SafeURL(classURL(l.Package, l.Name)) }>{ l.Name }</a>
								}
							}
						</span>
					</div>
				}
			</div>
		}
		<div class="uml-section">
			if len(d.Methods) == 0 {
				<div class="uml-empty">aucune méthode</div>
			}
			for _, m := range d.Methods {
				<div class="uml-row">
					<span class="uml-vis">{ visibility(m.Exported) }</span>
					<span class="uml-member uml-method">{ m.Name }</span>
					<span class="uml-type">{ m.Signature }</span>
				</div>
			}
		</div>
	</div>
}

templ refGroup(title, arrow string, refs []RefView) {
	if len(refs) > 0 {
		<div class="rel-group">
			<div class="rel-title"><span class="rel-arrow">{ arrow }</span> { title }</div>
			<div class="rel-list">
				for _, r := range refs {
					<a href={ templ.SafeURL(classURL(r.Package, r.Name)) } title={ r.PackageLabel }>{ r.Name }</a>
				}
			</div>
		</div>
	}
}

templ Relations(d TypeDetailView) {
	<div class="relations">
		@refGroup("Embarque (embed, l'« héritage » Go)", "▲", d.Embeds)
		@refGroup("Embarqué par", "▼", d.EmbeddedBy)
		@refGroup("Implémente", "◇", d.Implements)
		@refGroup("Implémenté par", "◆", d.ImplementedBy)
		@refGroup("Référencé par (champs)", "←", d.ReferencedBy)
		if len(d.Embeds)+len(d.EmbeddedBy)+len(d.Implements)+len(d.ImplementedBy)+len(d.ReferencedBy) == 0 {
			<p class="muted">Aucune relation avec les autres types du module.</p>
		}
	</div>
}
