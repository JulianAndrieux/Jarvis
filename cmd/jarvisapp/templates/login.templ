package templates

// LoginView : l'écran de connexion.
type LoginView struct {
	// GoogleReady : un client OAuth est configuré. Faux, le bouton Google
	// n'a rien à faire ici — mieux qu'un bouton qui échoue.
	GoogleReady bool
	// Reason : pourquoi la connexion précédente a échoué ("" : première
	// visite). Toujours une phrase choisie par le serveur, jamais un texte
	// venu de l'URL.
	Reason string
}

templ LoginPage(v LoginView) {
	<!DOCTYPE html>
	<html lang="fr" class="theme-user">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Jarvis — Connexion</title>
			<style>
				:root { color-scheme: light; --bg: #f6f7f9; --surface: #fff; --text: #1a1d21; --text-2: #5b6470; --border: #e3e6ea; --accent: #2f6feb; }
				* { box-sizing: border-box; }
				body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
					background: var(--bg); color: var(--text);
					font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif; }
				.card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px;
					padding: 2.5rem; width: min(26rem, 92vw); box-shadow: 0 1px 3px rgba(0,0,0,.06); }
				h1 { margin: 0 0 .25rem; font-size: 1.5rem; }
				p.sub { margin: 0 0 1.75rem; color: var(--text-2); font-size: .95rem; }
				.reason { background: #fdf0ef; border: 1px solid #f3c9c4; color: #8a2a22;
					padding: .7rem .9rem; border-radius: 10px; font-size: .9rem; margin-bottom: 1.25rem; }
				a.google { display: block; text-align: center; padding: .8rem 1rem; border-radius: 10px;
					background: var(--accent); color: #fff; text-decoration: none; font-weight: 600; }
				a.google:hover { filter: brightness(1.05); }
				.note { margin: 1.5rem 0 0; color: var(--text-2); font-size: .82rem; line-height: 1.5; }
			</style>
		</head>
		<body>
			<main class="card">
				<h1>Jarvis</h1>
				<p class="sub">Documents, emails, notes et tâches.</p>
				if v.Reason != "" {
					<div class="reason">{ v.Reason }</div>
				}
				if v.GoogleReady {
					<a class="google" href="/auth/google">Se connecter avec Google</a>
					<p class="note">
						Seuls les comptes invités à un environnement peuvent entrer.
						Si Google est injoignable, le lien de secours du propriétaire
						est écrit dans le journal de démarrage.
					</p>
				} else {
					<p class="note">
						Aucun fournisseur d'identité n'est configuré sur cette
						instance. Renseigne un client OAuth Google dans la
						configuration pour activer la connexion.
					</p>
				}
			</main>
		</body>
	</html>
}
