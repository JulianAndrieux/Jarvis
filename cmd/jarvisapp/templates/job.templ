package templates

import (
	"fmt"
	"strings"
	"time"

	"github.com/JulianAndrieux/Jarvis/internal/formats"
	"github.com/JulianAndrieux/Jarvis/internal/webapp"
)

// formatStarted formate l'instant de début du traitement en cours
// (Job.StartedAt) — affiché pendant pending/running pour répondre à
// "combien de temps est-ce en train de tourner ?" (jalon 20 : un vrai
// job resté bloqué "running" après un redémarrage du serveur n'avait
// jusqu'ici aucun repère visible pour le remarquer).
func formatStarted(job webapp.Job) string {
	if job.StartedAt.IsZero() {
		return "en attente de démarrage"
	}
	return "démarré à " + job.StartedAt.Local().Format("15:04:05")
}

// formatDuration décrit le temps de traitement d'un job terminé — "" si
// StartedAt n'est pas renseigné (job créé avant le jalon 20, ou jamais
// vraiment démarré).
func formatDuration(job webapp.Job) string {
	if job.StartedAt.IsZero() {
		return ""
	}
	return fmt.Sprintf("démarré à %s, terminé en %s", job.StartedAt.Local().Format("15:04:05"), job.FinishedAt.Sub(job.StartedAt).Round(100*time.Millisecond))
}

// FieldView est la vue d'un champ extrait (schema.Field aplati), prête à
// afficher — construite par cmd/jarvisapp à partir du JSON brut, pour ne
// coupler ni internal/extraction ni internal/schema à une préoccupation
// d'affichage.
type FieldView struct {
	Name          string
	Value         string
	Confidence    float64
	SourceSnippet string
	BBox          string
}

// PageView est la vue d'une page traitée par l'étage Extraction.
type PageView struct {
	Page        int
	Fields      []FieldView
	NeedsReview bool
	Failed      bool
	Error       string
	// Model, Prompt et RawJSON (jalon 22) : provenance et sortie brute
	// du LLM, affichées dans l'onglet "Analyse LLM".
	Model   string
	Prompt  string
	RawJSON string
}

// OCRPageView est le texte d'une page tel qu'envoyé au LLM (jalon 22,
// onglet "Texte OCR"). Source vaut "Texte natif" ou "VLM" ; Model n'est
// renseigné que pour le VLM.
type OCRPageView struct {
	Page   int
	Source string
	Model  string
	Text   string
	Failed bool
	Error  string
}

// ResultView est la vue complète d'un document traité.
type ResultView struct {
	DocType      string
	TriageScore  float64
	HasTextLayer bool
	PageCount    int
	Pages        []PageView
	// Merged est la fusion de toutes les pages en un enregistrement par
	// document (meilleure confiance par champ) — voir
	// extraction.MergePages. Réutilise PageView (même forme d'affichage),
	// son champ Page n'est pas significatif ici.
	Merged PageView
	// ClassificationConfidence est le score de confiance de la
	// classification automatique du type de document (0 si non
	// applicable). Renseigné même quand DocType est vide (aucun type
	// reconnu), pour expliquer pourquoi.
	ClassificationConfidence float64
	OCRPages                 []OCRPageView
	// NativeTextMissing : résultat antérieur au jalon 22, dont le texte
	// des pages natives n'a pas été conservé (seul le Markdown VLM l'était).
	NativeTextMissing bool
	// Progress n'est renseigné que pour un job sans résultat (en cours ou
	// interrompu) — jalon 23.
	Progress *ProgressView
}

// ProgressView résume l'étape en cours : libellé ("Lecture OCR (VLM)"),
// compteur ("2/5", vide si sans objet) et pourcentage de l'étape.
type ProgressView struct {
	Label   string
	Count   string
	Percent int
}

func progressWidth(p *ProgressView) templ.SafeCSS {
	return templ.SafeCSS(fmt.Sprintf("width: %d%%;", p.Percent))
}

func statusLabel(s webapp.Status) string {
	switch s {
	case webapp.StatusPending:
		return "En attente"
	case webapp.StatusRunning:
		return "Traitement en cours"
	case webapp.StatusDone:
		return "Terminé"
	case webapp.StatusFailed:
		return "Échec"
	default:
		return string(s)
	}
}

func yesNo(b bool) string {
	if b {
		return "oui"
	}
	return "non"
}

// lowConfidence reprend le seuil d'affichage historique de la vue
// (0.7) — la décision "à revoir" qui fait foi reste NeedsReview, calculée
// par internal/extraction.
func lowConfidence(f FieldView) bool {
	return f.Confidence < 0.7
}

func rowClass(f FieldView) string {
	if lowConfidence(f) {
		return "needs-review"
	}
	return ""
}

// humanizeFieldName rend un chemin de champ lisible : "total_ttc" ->
// "Total ttc", "lignes[0].montant" -> "Lignes[0] › montant".
func humanizeFieldName(name string) string {
	name = strings.ReplaceAll(name, "_", " ")
	name = strings.ReplaceAll(name, ".", " › ")
	if name == "" {
		return name
	}
	return strings.ToUpper(name[:1]) + name[1:]
}

func confidencePct(c float64) string {
	return fmt.Sprintf("%.0f%%", c*100)
}

func confidenceWidth(c float64) templ.SafeCSS {
	if c < 0 {
		c = 0
	}
	if c > 1 {
		c = 1
	}
	return templ.SafeCSS(fmt.Sprintf("width: %.0f%%;", c*100))
}

// persistedNote rend visible, à chaque état du job, que le document est
// bien enregistré dans MongoDB (le job y est créé dès la soumission,
// avant même le traitement) — sinon rien dans l'interface ne le confirme
// explicitement.
templ persistedNote(jobID string) {
	<p class="muted">✓ Enregistré dans MongoDB (id: { jobID })</p>
}

// progressBlock affiche l'étape en cours et sa barre d'avancement.
templ progressBlock(p *ProgressView) {
	<div class="progress">
		<div class="progress-label">
			<span>{ p.Label }</span>
			if p.Count != "" {
				<strong>{ p.Count }</strong>
			}
		</div>
		<div class="progress-bar"><span style={ progressWidth(p) }></span></div>
	</div>
}

templ statusChip(s webapp.Status) {
	<span class={ "chip", "chip-" + string(s) }><span class="dot"></span>{ statusLabel(s) }</span>
}

// FieldList affiche des champs extraits (valeur, confiance, extrait
// source, position) — onglet "Données" et détail par page.
templ FieldList(fields []FieldView) {
	if len(fields) == 0 {
		<p class="muted">Aucun champ extrait.</p>
	} else {
		<div class="field-list">
			for _, f := range fields {
				<div class={ "field", templ.KV("low", lowConfidence(f)) }>
					<div class="field-name">{ humanizeFieldName(f.Name) }</div>
					<div class="field-value">
						if f.Value == "" || f.Value == "<nil>" {
							<span class="muted">—</span>
						} else {
							{ f.Value }
						}
					</div>
					<div class="field-extra">
						<span class="conf confidence" title="Confiance">
							<span class="conf-bar"><span style={ confidenceWidth(f.Confidence) }></span></span>
							{ confidencePct(f.Confidence) }
						</span>
						if f.SourceSnippet != "" {
							<span class="snippet" title={ f.SourceSnippet }>« { f.SourceSnippet } »</span>
						}
						if f.BBox != "" {
							<span title="Position (points PDF)">{ f.BBox }</span>
						}
					</div>
				</div>
			}
		</div>
	}
}

// JobFragment est la carte de suivi d'un upload (page Importer) : elle
// sonde /jobs/{id} tant que le traitement tourne, puis résume le
// résultat avec un lien vers la vue détail complète.
templ JobFragment(job webapp.Job, view ResultView) {
	if job.Status == webapp.StatusPending || job.Status == webapp.StatusRunning {
		<div id={ "job-" + job.ID } class="card" hx-get={ "/jobs/" + job.ID } hx-trigger="load delay:1.5s" hx-swap="outerHTML">
			<p class={ "status-" + string(job.Status) }>
				<span class="spinner"></span>
				{ statusLabel(job.Status) } — <strong>{ job.Filename }</strong>
			</p>
			if view.Progress != nil {
				@progressBlock(view.Progress)
			}
			<p class="muted">{ formatStarted(job) }</p>
			@persistedNote(job.ID)
			<a class="button" href={ templ.SafeURL("/documents/" + job.ID) }>Suivre dans le document →</a>
		</div>
	} else if job.Status == webapp.StatusFailed {
		<div id={ "job-" + job.ID } class="card">
			<p class="status-failed">Échec — <strong>{ job.Filename }</strong></p>
			<div class="error-box">{ job.Err }</div>
			<p class="muted">{ formatDuration(job) }</p>
			@persistedNote(job.ID)
			<a class="button" href={ templ.SafeURL("/documents/" + job.ID) }>Ouvrir le document →</a>
		</div>
	} else if fileFamily(job) == formats.Other {
		<div id={ "job-" + job.ID } class="card">
			<p class="status-done">Stocké — <strong>{ job.Filename }</strong> <span class="muted">({ HumanSize(job.Size) })</span></p>
			<p class="muted">Pas d'aperçu ni d'extraction pour ce type de fichier ; il reste téléchargeable depuis la bibliothèque.</p>
			@persistedNote(job.ID)
			<a class="button" href={ templ.SafeURL("/documents/" + job.ID) }>Ouvrir →</a>
		</div>
	} else if view.DocType == "" {
		<div id={ "job-" + job.ID } class="card">
			<p class="status-done">Terminé — <strong>{ job.Filename }</strong></p>
			<p class="warn-box">
				⚠ Aucun type de document reconnu (confiance { fmt.Sprintf("%.2f", view.ClassificationConfidence) }) —
				pas d'extraction possible. Le document reste enregistré tel quel.
			</p>
			<p class="muted">{ formatDuration(job) }</p>
			@persistedNote(job.ID)
			<a class="button" href={ templ.SafeURL("/documents/" + job.ID) }>Ouvrir le document →</a>
		</div>
	} else {
		<div id={ "job-" + job.ID } class="card">
			<p class="status-done">
				Terminé — <strong>{ job.Filename }</strong> <span class="chip chip-type">{ view.DocType }</span>
				if view.ClassificationConfidence > 0 {
					<span class="muted">classification { fmt.Sprintf("%.2f", view.ClassificationConfidence) }</span>
				} else {
					<span class="muted">type assigné manuellement</span>
				}
			</p>
			<p class="muted">{ formatDuration(job) }</p>
			if view.Merged.Failed {
				<div class="error-box">{ view.Merged.Error }</div>
			} else {
				@FieldList(view.Merged.Fields)
			}
			@persistedNote(job.ID)
			<a class="button button-primary" href={ templ.SafeURL("/documents/" + job.ID) }>Ouvrir le document →</a>
		</div>
	}
}
