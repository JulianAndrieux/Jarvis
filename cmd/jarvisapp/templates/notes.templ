package templates

import (
	"fmt"

	"github.com/JulianAndrieux/Jarvis/internal/notes"
)

// NotesPage : la liste des notes, avec recherche, tags et dates.
templ NotesPage(cards []NoteCard, f NotesFilters, tags []string) {
	@Layout("Jarvis — notes", "notes") {
		<div class="page-wide">
			<div class="page-title">
				<h2>Notes</h2>
				<form method="post" action="/notes">
					<button type="submit" class="button-primary">+ Nouvelle note</button>
				</form>
			</div>
			<form class="search-bar" method="get" action="/notes">
				<input type="text" name="q" value={ f.Search } placeholder="Rechercher dans les titres, le texte des boîtes et les tags…"/>
				<label class="date-field">Modifiée du <input type="date" name="from" value={ f.From }/></label>
				<label class="date-field">au <input type="date" name="to" value={ f.To }/></label>
				if f.Tag != "" {
					<input type="hidden" name="tag" value={ f.Tag }/>
				}
				<button type="submit">Rechercher</button>
				if f.Active() {
					<a class="button button-ghost" href="/notes">Effacer</a>
				}
			</form>
			if f.Error != "" {
				<p class="form-error" role="alert">{ f.Error }</p>
			}
			if len(tags) > 0 {
				<div class="type-filters">
					<a class={ "chip", "filter-chip", templ.KV("active", f.Tag == "") } href={ templ.SafeURL(notesFilterURL("", f)) }>Toutes</a>
					for _, tg := range tags {
						<a class={ "chip", "filter-chip", templ.KV("active", f.Tag == tg) } href={ templ.SafeURL(notesFilterURL(tg, f)) }>{ tg }</a>
					}
				</div>
			}
			if len(cards) == 0 {
				<div class="empty-state"><p>Aucune note.</p></div>
			} else {
				<div class="note-grid">
					for _, c := range cards {
						<a class="card note-card" href={ templ.SafeURL("/notes/" + c.ID) }>
							<div class="note-card-title">
								if c.Pinned {
									<span title="Épinglée">📌</span>
								}
								{ c.Title }
							</div>
							if c.Excerpt != "" {
								<p class="note-excerpt">{ c.Excerpt }</p>
							}
							<div class="doc-meta">
								for _, tg := range c.Tags {
									<span class="chip">{ tg }</span>
								}
							</div>
							<div class="doc-date">
								{ boxCount(c) } · { c.Updated }
							</div>
						</a>
					}
				</div>
			}
		</div>
	}
}

// NotePage : une note — son en-tête (toujours modifiable) puis sa
// colonne de boîtes.
templ NotePage(v NoteView) {
	@Layout("Jarvis — "+v.Note.Title, "notes") {
		<div class="page-wide note-page">
			<a class="panel-back" href="/notes">← Notes</a>
			<form class="card note-head" method="post" action={ templ.SafeURL("/notes/" + v.Note.ID) }>
				<div class="note-head-row">
					if v.Note.Pinned {
						<span title="Épinglée">📌</span>
					}
					<input class="note-title-input" type="text" name="title" value={ v.Note.Title } aria-label="Titre de la note"/>
					<button type="submit" class="button-primary">Enregistrer</button>
				</div>
				<div class="note-head-row">
					<input type="text" name="tags" value={ joinTags(v.Note.Tags) } placeholder="Tags, séparés par des virgules" aria-label="Tags de la note"/>
					<label class="inline-check"><input type="checkbox" name="pinned" checked?={ v.Note.Pinned }/> Épingler</label>
				</div>
				<div class="doc-meta">
					for _, tg := range v.Note.Tags {
						<a class="chip" href={ templ.SafeURL("/notes?tag=" + urlQuery(tg)) }>{ tg }</a>
					}
					if v.Note.MailID != "" {
						<a class="chip" href={ templ.SafeURL("/emails/" + v.Note.MailID) }>📧 { v.MailSubject }</a>
					}
					<span class="muted">modifiée le { v.Note.UpdatedAt.Local().Format("02/01/2006 15:04") }</span>
				</div>
			</form>
			<div id="note-blocks">
				@NoteBlocks(v.Blocks)
			</div>
			@noteEditorScript()
			<div class="section-title">Tâches de cette note</div>
			@quickAddForm(v.Note.ID, "", "/notes/"+v.Note.ID)
			@taskGroups(v.Tasks, "/notes/"+v.Note.ID)
			<div class="section-title">Documents liés</div>
			@docLinks(v)
			<div class="section-title">Zone dangereuse</div>
			<form method="post" action={ templ.SafeURL("/notes/" + v.Note.ID + "/delete") } onsubmit="return confirm('Supprimer cette note ? Ses tâches sont gardées.')">
				<button type="submit" class="button-danger">Supprimer la note</button>
			</form>
		</div>
	}
}

// NoteBlocks : la colonne de boîtes d'une note. Seul fragment rendu par
// les actions de boîte — un refus arrive dans v.Error (statut 200 :
// HTMX ne remplacerait pas la cible sur une réponse 4xx).
templ NoteBlocks(v NoteBlocksView) {
	if v.Error != "" {
		<p class="form-error" role="alert">{ v.Error }</p>
	}
	<div class="note-blocks">
		@addBlockButton(v, "")
		for _, b := range v.Blocks {
			@noteBlock(b, v)
			@addBlockButton(v, b.ID)
		}
	</div>
	if v.ArchivedCount > 0 {
		<p class="muted note-archives">
			{ plural(v.ArchivedCount, "boîte archivée", "boîtes archivées") } —
			if v.ShowArchived {
				<a href="#" hx-get={ blocksURL(NoteBlocksView{NoteID: v.NoteID}, v.EditID) } hx-target="#note-blocks" hx-swap="innerHTML">Masquer</a>
			} else {
				<a href="#" hx-get={ blocksURL(NoteBlocksView{NoteID: v.NoteID, ShowArchived: true}, v.EditID) } hx-target="#note-blocks" hx-swap="innerHTML">Afficher</a>
			}
		</p>
	}
}

// addBlockButton : « + Boîte » entre deux boîtes (after = la boîte au
// dessus, "" = tout en haut).
templ addBlockButton(v NoteBlocksView, after string) {
	<form class="add-block" hx-post={ blocksURL(v, "") } hx-target="#note-blocks" hx-swap="innerHTML">
		<input type="hidden" name="after" value={ after }/>
		<button type="submit" class="button-ghost" title="Ajouter une boîte ici">+ Boîte</button>
	</form>
}

templ noteBlock(b BlockView, v NoteBlocksView) {
	<div class={ "note-block", templ.KV("archived", b.Archived), templ.KV("editing", b.Editing) }>
		if b.Editing {
			@noteBlockEditor(b, v)
		} else {
			<div class="note-block-body markdown">
				if b.Text == "" {
					<p class="muted">Boîte vide — « Modifier » pour l'écrire.</p>
				} else {
					@templ.Raw(b.HTML)
				}
			</div>
			<div class="block-tags">
				for _, tg := range b.Tags {
					<a class="chip" href={ templ.SafeURL("/notes?tag=" + urlQuery(tg)) }>{ tg }</a>
				}
				if b.TaskID != "" {
					<a class="chip chip-done" href={ templ.SafeURL("/tasks/" + b.TaskID) }>✅ { b.TaskTitle }</a>
				}
				if b.Archived {
					<span class="chip">archivée le { b.ArchivedAt }</span>
				}
			</div>
			<div class="note-block-actions">
				<button class="button-ghost" hx-get={ blocksURL(v, b.ID) } hx-target="#note-blocks" hx-swap="innerHTML">Modifier</button>
				@blockAction(v, b.ID, "move", "↑", "Monter") {
					<input type="hidden" name="dir" value="up"/>
				}
				@blockAction(v, b.ID, "move", "↓", "Descendre") {
					<input type="hidden" name="dir" value="down"/>
				}
				if b.TaskID == "" {
					@blockAction(v, b.ID, "task", "→ Tâche", "Transformer en tâche") {
					}
				}
				if b.Archived {
					@blockAction(v, b.ID, "unarchive", "Désarchiver", "Remettre en place") {
					}
				} else {
					<form class="inline-form block-archive" hx-post={ blockURL(v, b.ID, "archive") } hx-target="#note-blocks" hx-swap="innerHTML">
						<input type="text" name="tags" value={ joinTags(b.Tags) } placeholder="tag…" aria-label="Tags de l'archive"/>
						<button type="submit" class="button-ghost" title="Archiver en la taguant">Archiver</button>
					</form>
				}
				<form class="inline-form" hx-post={ blockURL(v, b.ID, "delete") } hx-target="#note-blocks" hx-swap="innerHTML" hx-confirm="Supprimer cette boîte ?">
					<button type="submit" class="button-ghost" title="Supprimer la boîte">✕</button>
				</form>
			</div>
		}
	</div>
}

// blockAction : un bouton d'action sur une boîte (les champs cachés
// éventuels sont passés en contenu).
templ blockAction(v NoteBlocksView, blockID, action, label, title string) {
	<form class="inline-form" hx-post={ blockURL(v, blockID, action) } hx-target="#note-blocks" hx-swap="innerHTML">
		{ children... }
		<button type="submit" class="button-ghost" title={ title }>{ label }</button>
	</form>
}

// noteBlockEditor : l'éditeur d'une boîte — barre d'outils Markdown,
// aperçu rendu par le serveur. L'enregistrement a aussi lieu quand le
// focus quitte la boîte : ouvrir une autre boîte ne perd pas la saisie.
// La condition sur relatedTarget garde l'éditeur ouvert tant qu'on
// circule dedans (texte → tags → barre d'outils).
templ noteBlockEditor(b BlockView, v NoteBlocksView) {
	<form
		class="block-editor"
		hx-post={ blockURL(v, b.ID, "") }
		hx-target="#note-blocks"
		hx-swap="innerHTML"
		hx-trigger="submit, focusout[!this.contains(event.relatedTarget)]"
	>
		<div class="md-toolbar">
			for _, t := range mdTools {
				<button type="button" data-md={ t.Key } title={ t.Title } onmousedown="event.preventDefault()">{ t.Label }</button>
			}
		</div>
		<textarea name="text" rows="6" class="mono" aria-label="Texte de la boîte">{ b.Text }</textarea>
		<div class="field-row block-editor-row">
			<input type="text" name="tags" value={ joinTags(b.Tags) } placeholder="Tags de la boîte, séparés par des virgules" aria-label="Tags de la boîte"/>
			<button type="button" class="button-ghost" hx-post="/notes/blocks/preview" hx-include="closest form" hx-target="next .block-preview">Aperçu</button>
			<button type="submit" class="button-primary">Enregistrer</button>
		</div>
		<div class="block-preview markdown"></div>
		<p class="muted quick-help">Markdown : ## titre, - liste, **gras**, `code`. ⌘/Ctrl+B gras, ⌘/Ctrl+I italique, ⌘/Ctrl+↵ enregistre. Quitter la boîte l'enregistre aussi.</p>
	</form>
}

// MarkdownPreview : l'aperçu d'une boîte, rendu par le serveur (aucune
// bibliothèque Markdown chargée dans le navigateur).
templ MarkdownPreview(html string) {
	<div class="markdown">
		@templ.Raw(html)
	</div>
}

// noteEditorScript : la barre d'outils et les raccourcis de l'éditeur.
// En délégation sur document : les boîtes sont remplacées par HTMX, un
// écouteur posé sur elles disparaîtrait avec elles.
templ noteEditorScript() {
	<script>
		(function () {
			if (window.jarvisNoteEditor) return;
			window.jarvisNoteEditor = true;
			var WRAP = { bold: ["**", "**"], italic: ["*", "*"], strike: ["~~", "~~"], code: ["`", "`"] };
			var LINE = { h: "## ", ul: "- ", ol: "1. ", quote: "> " };
			function grow(ta) { ta.style.height = "auto"; ta.style.height = (ta.scrollHeight + 4) + "px"; }
			function apply(ta, kind) {
				var s = ta.selectionStart, e = ta.selectionEnd, v = ta.value;
				if (WRAP[kind]) {
					var w = WRAP[kind];
					ta.value = v.slice(0, s) + w[0] + v.slice(s, e) + w[1] + v.slice(e);
					ta.selectionStart = s + w[0].length;
					ta.selectionEnd = e + w[0].length;
				} else if (LINE[kind]) {
					var start = v.lastIndexOf("\n", s - 1) + 1;
					ta.value = v.slice(0, start) + LINE[kind] + v.slice(start);
					ta.selectionStart = ta.selectionEnd = s + LINE[kind].length;
				}
				grow(ta);
				ta.focus();
			}
			document.addEventListener("click", function (ev) {
				var btn = ev.target.closest("[data-md]");
				if (!btn) return;
				var form = btn.closest("form");
				var ta = form && form.querySelector("textarea");
				if (!ta) return;
				ev.preventDefault();
				apply(ta, btn.getAttribute("data-md"));
			});
			document.addEventListener("keydown", function (ev) {
				var ta = ev.target;
				if (!ta.matches || !ta.matches(".block-editor textarea")) return;
				var mod = ev.metaKey || ev.ctrlKey;
				if (mod && (ev.key === "b" || ev.key === "i")) {
					ev.preventDefault();
					apply(ta, ev.key === "b" ? "bold" : "italic");
				} else if (mod && ev.key === "Enter") {
					ev.preventDefault();
					ta.form.requestSubmit();
				} else if (ev.key === "Tab") {
					ev.preventDefault();
					var s = ta.selectionStart;
					ta.value = ta.value.slice(0, s) + "  " + ta.value.slice(ta.selectionEnd);
					ta.selectionStart = ta.selectionEnd = s + 2;
				}
			});
			document.addEventListener("input", function (ev) {
				if (ev.target.matches && ev.target.matches(".block-editor textarea")) grow(ev.target);
			});
			document.addEventListener("htmx:afterSwap", function () {
				document.querySelectorAll(".block-editor textarea").forEach(function (ta) { grow(ta); ta.focus(); });
			});
		})();
	</script>
}

templ docLinks(v NoteView) {
	if len(v.Docs) == 0 {
		<p class="muted">Aucun document lié.</p>
	} else {
		<ul class="link-list">
			for _, d := range v.Docs {
				<li>
					<a href={ templ.SafeURL("/documents/" + d.ID) }>📄 { d.Name }</a>
					<form class="inline-form" method="post" action={ templ.SafeURL("/notes/" + v.Note.ID + "/docs/" + d.ID + "/unlink") }>
						<button type="submit" class="button-ghost" title="Retirer le lien">✕</button>
					</form>
				</li>
			}
		</ul>
	}
	if len(v.Choices) > 0 {
		<form class="field-row" method="post" action={ templ.SafeURL("/notes/" + v.Note.ID + "/docs") }>
			<select name="doc">
				for _, d := range v.Choices {
					<option value={ d.ID }>{ d.Name }</option>
				}
			</select>
			<button type="submit">Lier ce document</button>
		</form>
	}
}

// TasksPage : la todo, par groupe.
templ TasksPage(groups []TaskGroupView) {
	@Layout("Jarvis — tâches", "tasks") {
		<div class="page-wide tasks-page">
			<div class="page-title">
				<h2>Tâches</h2>
			</div>
			@quickAddForm("", "", "/tasks")
			if len(groups) == 0 {
				<div class="empty-state"><p>Rien à faire. Ajoute une tâche ci-dessus.</p></div>
			}
			@taskGroups(groups, "/tasks")
		</div>
	}
}

templ quickAddForm(noteID, docID, back string) {
	<form class="quick-add" method="post" action="/tasks">
		<input type="text" name="text" required placeholder="Nouvelle tâche… ex. Appeler le notaire demain !" title={ quickAddHelp }/>
		<input type="hidden" name="note" value={ noteID }/>
		<input type="hidden" name="doc" value={ docID }/>
		<input type="hidden" name="back" value={ back }/>
		<button type="submit" class="button-primary">Ajouter</button>
	</form>
	<p class="muted quick-help">{ quickAddHelp }</p>
}

templ taskGroups(groups []TaskGroupView, back string) {
	for _, g := range groups {
		<div class={ "task-group", "task-group-" + string(g.Bucket) }>
			<div class="task-group-title">{ g.Label } <span class="count">{ fmt.Sprint(len(g.Tasks)) }</span></div>
			<ul class="task-list">
				for _, t := range g.Tasks {
					@taskRow(t, back)
				}
			</ul>
		</div>
	}
}

templ taskRow(t TaskView, back string) {
	<li class={ "task-row", templ.KV("task-done", t.Done) }>
		<form class="inline-form" method="post" action={ templ.SafeURL("/tasks/" + t.ID + "/toggle") }>
			<input type="hidden" name="back" value={ back }/>
			<button type="submit" class="task-check" title="Cocher / décocher">
				if t.Done {
					☑
				} else {
					☐
				}
			</button>
		</form>
		<a class="task-title" href={ templ.SafeURL("/tasks/" + t.ID) }>{ t.Title }</a>
		if t.Priority == notes.High {
			<span class="chip chip-failed">haute</span>
		} else if t.Priority == notes.Low {
			<span class="chip">basse</span>
		}
		if t.DueLabel != "" {
			<span class={ "chip", templ.KV("chip-failed", t.Overdue), templ.KV("chip-review", !t.Overdue) }>{ t.DueLabel }</span>
		}
		if t.NoteID != "" {
			<a class="chip" href={ templ.SafeURL("/notes/" + t.NoteID) }>📝 { t.NoteTitle }</a>
		}
		if t.DocID != "" {
			<a class="chip" href={ templ.SafeURL("/documents/" + t.DocID) }>📄 { t.DocName }</a>
		}
		if t.MailID != "" {
			<a class="chip" href={ templ.SafeURL("/emails/" + t.MailID) }>📧 { t.MailSubject }</a>
		}
	</li>
}

// TaskEditPage : modifier une tâche.
templ TaskEditPage(v TaskEditView) {
	@Layout("Jarvis — tâche", "tasks") {
		<div class="page-wide note-page">
			<a class="panel-back" href="/tasks">← Tâches</a>
			<form class="card note-editor" method="post" action={ templ.SafeURL("/tasks/" + v.Task.ID) }>
				if v.Error != "" {
					<p class="form-error" role="alert">{ v.Error }</p>
				}
				<label for="title">Tâche</label>
				<input type="text" id="title" name="title" value={ v.Task.Title }/>
				<div class="task-fields">
					<label>Échéance <input type="date" name="due" value={ v.Task.Due }/></label>
					<label>
						Priorité
						<select name="priority">
							<option value="" selected?={ v.Task.Priority == notes.Normal }>normale</option>
							<option value="haute" selected?={ v.Task.Priority == notes.High }>haute</option>
							<option value="basse" selected?={ v.Task.Priority == notes.Low }>basse</option>
						</select>
					</label>
				</div>
				<label for="note">Note liée</label>
				<select id="note" name="note">
					<option value="">— aucune —</option>
					for _, n := range v.Notes {
						<option value={ n.ID } selected?={ n.ID == v.Task.NoteID }>{ n.Name }</option>
					}
				</select>
				<label for="doc">Document lié</label>
				<select id="doc" name="doc">
					<option value="">— aucun —</option>
					for _, d := range v.Docs {
						<option value={ d.ID } selected?={ d.ID == v.Task.DocID }>{ d.Name }</option>
					}
				</select>
				<div class="field-row">
					<button type="submit" class="button-primary">Enregistrer</button>
					<a class="button button-ghost" href="/tasks">Annuler</a>
				</div>
			</form>
			<form method="post" action={ templ.SafeURL("/tasks/" + v.Task.ID + "/delete") } onsubmit="return confirm('Supprimer cette tâche ?')">
				<button type="submit" class="button-danger">Supprimer la tâche</button>
			</form>
		</div>
	}
}

// DocumentLinks : notes et tâches liées à un document (fiche du document,
// chargé à part).
templ DocumentLinks(v DocumentLinksView) {
	<div class="section-title">Notes et tâches</div>
	if len(v.Notes) > 0 {
		<ul class="link-list">
			for _, n := range v.Notes {
				<li><a href={ templ.SafeURL("/notes/" + n.ID) }>📝 { n.Title }</a></li>
			}
		</ul>
	}
	<form class="inline-form" method="post" action="/notes">
		<input type="hidden" name="doc" value={ v.DocID }/>
		<button type="submit">+ Note sur ce document</button>
	</form>
	@quickAddForm("", v.DocID, "/documents/"+v.DocID)
	@taskGroups(v.Tasks, "/documents/"+v.DocID)
}
